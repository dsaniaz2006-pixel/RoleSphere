# Local HTTP (not for public deployment)
NODE_ENV=development
PORT=8000
BASE_URL=http://localhost:8000
HTTPS_ENABLED=false
COOKIE_SECURE=false
TRUST_PROXY=false
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Add MONGO_URI, SESSION_SECRET, JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET in root .env.
