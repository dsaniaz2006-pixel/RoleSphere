# Example for a hosting provider that terminates TLS (NOT standalone local HTTPS)
NODE_ENV=production
PORT=8000
BASE_URL=https://your-domain.example
HTTPS_ENABLED=false
COOKIE_SECURE=true
TRUST_PROXY=true
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
# Supply MONGO_URI, SESSION_SECRET, JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET via secret environment variables.
# Never copy local mkcert TLS private keys into deployment secrets.
