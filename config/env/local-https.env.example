# Direct HTTPS on your Mac; generate local certs with npm run https:setup
NODE_ENV=development
PORT=8001
BASE_URL=https://localhost:8001
HTTPS_ENABLED=true
COOKIE_SECURE=true
TRUST_PROXY=false
TLS_CERT_PATH=certs/localhost.pem
TLS_KEY_PATH=certs/localhost-key.pem
GOOGLE_REDIRECT_URI=https://localhost:8001/api/auth/google/callback
# Add MONGO_URI, SESSION_SECRET, JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET in root .env.
