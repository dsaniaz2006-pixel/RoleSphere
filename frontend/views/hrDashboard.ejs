        // ── Attendance System ── //
        const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
        let attInterval = null;

        function formatDuration(ci, co) {
            if (!ci||ci==='-'||!co||co==='-') return '--:--:--';
            const ts = t => { const [h,m,s]=t.split(':').map(Number); return h*3600+m*60+s; };
            let d=ts(co)-ts(ci); if(d<0)d+=86400;
            return [Math.floor(d/3600),Math.floor((d%3600)/60),d%60].map(n=>String(n).padStart(2,'0')).join(':');
        }

        function startLiveTimer(ci) {
            document.getElementById('myLiveTimer').classList.remove('hidden');
            if (attInterval) clearInterval(attInterval);
            const ts = t => { const [h,m,s]=t.split(':').map(Number); return h*3600+m*60+s; };
            const start = ts(ci);
            attInterval = setInterval(() => {
                const now = new Date();
                let d = (now.getHours()*3600+now.getMinutes()*60+now.getSeconds()) - start;
                if(d<0)d=0;
                document.getElementById('myTimerDisplay').innerText = [Math.floor(d/3600),Math.floor((d%3600)/60),d%60].map(n=>String(n).padStart(2,'0')).join(':');
            }, 1000);
        }

        async function myCheckIn() {
            if (!MY_USER_ID) return alert('Session expired. Please login again.');
            const r = await fetch('/api/attendance/checkin', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({userId:MY_USER_ID, userModel:MY_USER_MODEL}) });
            const d = await r.json();
            if (!d.success) return alert(d.error||'Check-in failed');
            document.getElementById('myCheckInTime').innerText = d.record.checkIn;
            document.getElementById('myAttStatus').innerText='Checked In';
            document.getElementById('myAttStatus').className='inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-700';
            document.getElementById('myCheckInBtn').classList.add('hidden');
            document.getElementById('myCheckOutBtn').classList.remove('hidden');
            startLiveTimer(d.record.checkIn);
        }

        async function myCheckOut() {
            if (!MY_USER_ID) return;
            const r = await fetch('/api/attendance/checkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({userId:MY_USER_ID}) });
            const d = await r.json();
            if (!d.success) return alert(d.error||'Check-out failed');
            clearInterval(attInterval);
            document.getElementById('myLiveTimer').classList.add('hidden');
            document.getElementById('myCheckOutTime').innerText = d.record.checkOut;
            document.getElementById('myDuration').innerText = formatDuration(d.record.checkIn, d.record.checkOut);
            document.getElementById('myAttStatus').innerText='Checked Out';
            document.getElementById('myAttStatus').className='inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-700';
            document.getElementById('myCheckOutBtn').classList.add('hidden');
        }

        async function loadMyAttendanceStatus() {
            if (!MY_USER_ID) return;
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('myAttDate').innerText = today + ' (' + DAYS[new Date().getDay()] + ')';
            if (new Date().getDay()===0) {
                document.getElementById('mySundayMsg').classList.remove('hidden');
                document.getElementById('myCheckInBtn').disabled=true;
                return;
            }
            try {
                const r = await fetch('/api/attendance/today-status?userId='+MY_USER_ID);
                const d = await r.json();
                if (!d.record) return;
                const rec = d.record;
                document.getElementById('myCheckInTime').innerText = rec.checkIn||'--:--:--';
                document.getElementById('myCheckOutTime').innerText = rec.checkOut||'--:--:--';
                document.getElementById('myDuration').innerText = formatDuration(rec.checkIn, rec.checkOut);
                if (rec.checkIn && !rec.checkOut) {
                    document.getElementById('myAttStatus').innerText='Checked In';
                    document.getElementById('myAttStatus').className='inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-700';
                    document.getElementById('myCheckInBtn').classList.add('hidden');
                    document.getElementById('myCheckOutBtn').classList.remove('hidden');
                    startLiveTimer(rec.checkIn);
                } else if (rec.checkIn && rec.checkOut) {
                    document.getElementById('myAttStatus').innerText='Checked Out';
                    document.getElementById('myAttStatus').className='inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-700';
                    document.getElementById('myCheckInBtn').classList.add('hidden');
                    document.getElementById('myCheckOutBtn').classList.add('hidden');
                }
            } catch(e) { console.error(e); }
        }

        // My Monthly Attendance Record
        async function loadMyMonthlyAttendance() {
            const m = document.getElementById('myAttMonthPicker').value;
            if (!m) return alert('Please select a month');
            try {
                const r = await fetch('/api/attendance/my-history?userId='+MY_USER_ID+'&month='+m);
                const d = await r.json();
                const records = d.records || [];
                const [year,mon] = m.split('-').map(Number);
                const dim = new Date(year,mon,0).getDate();
                let html = '';
                for(let day=1;day<=dim;day++){
                    const ds=`${year}-${String(mon).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
                    const dow=new Date(ds).getDay();
                    const isSun=dow===0;
                    const rec=records.find(r=>r.date===ds);
                    let badge,rowCls='';
                    if(isSun){badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">Holiday</span>';rowCls='bg-purple-50';}
                    else if(rec?.checkIn){badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Present</span>';}
                    else{badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">Absent</span>';rowCls='bg-red-50';}
                    html+=`<tr class="${rowCls}"><td class="px-5 py-3 text-sm text-gray-700">${ds}</td><td class="px-5 py-3 text-sm font-medium ${isSun?'text-purple-600':'text-gray-700'}">${escapeHtml(DAYS[dow])}</td><td class="px-5 py-3">${badge}</td><td class="px-5 py-3 text-sm font-mono ${rec?.checkIn?'text-green-600 font-semibold':'text-gray-400'}">${rec?.checkIn||'-'}</td><td class="px-5 py-3 text-sm font-mono ${rec?.checkOut?'text-red-500 font-semibold':'text-gray-400'}">${rec?.checkOut||'-'}</td><td class="px-5 py-3 text-sm font-mono text-blue-600">${formatDuration(rec?.checkIn,rec?.checkOut)}</td></tr>`;
                }
                document.getElementById('myAttBody').innerHTML = html || '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-400">No records found</td></tr>';
            } catch(e) { console.error(e); alert('Failed to load attendance'); }
        }

