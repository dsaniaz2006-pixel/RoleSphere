<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/premium-head') %>
<script src="/vendor/purify.min.js"></script><script src="/js/ui.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Dashboard | RoleSphere</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/rolesphere-redesign.css">
    <link rel="stylesheet" href="/css/dashboard-background.css">
    <script defer src="/js/dashboard-background.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script>
        const MY_USER_ID = <%- jsonForScript(hr._id) %>;
        const MY_USER_MODEL = 'HR';
    </script>
    <style>
        .section-content { display: none; }
        .section-content.active { display: block; }
        .animate-fade-in-down { animation: fadeInDown 0.3s ease-out; }
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fc-toolbar-title { font-size: 1.25rem !important; font-weight: 700 !important; }
        .fc-button { background-color: #2563eb !important; border: none !important; }
        .fc-button:hover { background-color: #1d4ed8 !important; }
        .fc-day-today { background-color: #eff6ff !important; }
    </style>
<script src="/js/legacy/hrDashboard-events.js"></script>
<%- include('partials/premium-assets') %>
<link rel="stylesheet" href="/css/finance-dashboard.css"><script defer src="/js/finance-dashboard.js"></script>
    <link rel="stylesheet" href="/css/rolesphere-redesign.css?v=directory-fix-2">
</head>
<body class="rs-dashboard rs-finance-dashboard rs-dot-dashboard bg-gray-50 h-screen flex overflow-hidden">
<%- include('partials/finance-mobile') %>
    <!-- Sidebar -->
    <aside id="rs-role-sidebar" class="w-64 bg-white border-r border-gray-200 flex flex-col hidden md:flex">
        <div class="rs-sidebar-brand"><%- include('partials/brand') %></div>
        <nav class="flex-1 overflow-y-auto py-4 space-y-1">
        <!-- ══ ANNOUNCEMENT BELL — pinned top of sidebar ══════════════════ -->
        <!-- IMPORTANT: This sits OUTSIDE <nav> so it never scrolls away     -->
        <div class="relative border-b border-gray-100">
            <button
                id="ann-toggle-btn"
                data-rs-click="hrDashboard-0"
                class="w-full flex items-center justify-between px-4 py-3 hover:bg-blue-50 transition-all group"
                title="Announcements"
            >
                <div class="flex items-center gap-3">
                    <!-- Megaphone icon -->
                    <div class="relative">
                        <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                        </svg>
                        <!-- Unread badge — hidden when count is 0 -->
                        <span
                            id="ann-badge"
                            class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center px-1 hidden"
                        >0</span>
                    </div>
                    <span class="text-sm font-semibold text-gray-700 group-hover:text-primary-600">Announcements</span>
                </div>
                <!-- Chevron that rotates when panel opens -->
                <svg id="ann-chevron" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>

            <!-- ── Drop-down panel ────────────────────────────────────────── -->
            <div
                id="ann-panel"
                class="hidden bg-blue-50 border-t border-blue-100 max-h-72 overflow-y-auto"
            >
                <!-- Header row inside panel -->
                <div class="flex items-center justify-between px-4 py-2 border-b border-blue-100">
                    <span class="text-xs font-semibold text-blue-700 uppercase tracking-wider">Latest Announcements</span>
                    <button data-rs-click="hrDashboard-1" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Mark all read</button>
                </div>
                <!-- List of announcements -->
                <div id="ann-list" class="divide-y divide-blue-100">
                    <p class="text-xs text-gray-400 px-4 py-3">Loading…</p>
                </div>
            </div>
        </div>
        <!-- ══ END ANNOUNCEMENT BELL ════════════════════════════════════════ -->

            <button data-rs-click="hrDashboard-2" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="dashboard">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                Dashboard
            </button>
            <button data-rs-click="hrDashboard-3" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="leave">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a2 2 0 012-2h4a2 2 0 012 2v4m-6 4v10a2 2 0 002 2h4a2 2 0 002-2V11M9 11h6"></path></svg>
                Apply Leave
            </button>
            <button data-rs-click="hrDashboard-4" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="calendar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                Task Calendar
            </button>
            <button data-rs-click="hrDashboard-5" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="tasks">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                Assigned Tasks
            </button>
            <button data-rs-click="hrDashboard-6" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="managers">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M5 10h14M5 14h14M5 18h14"></path></svg>
                Managers
            </button>
            <button data-rs-click="hrDashboard-7" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="announcements">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
                Announcements
            </button>
            <!-- MY ATTENDANCE (check-in/out + monthly record) -->
            <button data-rs-click="hrDashboard-8" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="attendance">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                My Attendance
            </button>
            <!-- TEAM ATTENDANCE (employee + manager tables) -->
            <button data-rs-click="hrDashboard-9" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="team-attendance">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                Team Attendance
            </button>
            <!-- COMPLAINTS -->
            <button data-rs-click="hrDashboard-10" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none" data-section="complaints">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                Removal Complaints
            </button>
        <div class="px-6 pt-4 pb-1">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Management</p>
            </div>
            <button data-rs-click="hrDashboard-11" data-section="transfer" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7l4-4m0 0l4 4m-4-4v18M16 17l4 4m0 0l-4 4m4-4H3"></path></svg>
                <span class="text-sm font-medium">Transfer Requests</span>
            </button>
            <button data-rs-click="hrDashboard-12" data-section="performance" class="nav-item w-full flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all border-r-4 border-transparent focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                <span class="text-sm font-medium">Performance Reviews</span>
            </button>
        </nav>
        <div class="p-4 border-t border-gray-100">
            <a href="/hr/reports" class="flex items-center gap-3 px-4 py-3 text-gray-600 rounded-xl hover:bg-gray-100 transition-all font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Export Reports
            </a>
            <a href="/hr/logout" class="flex items-center gap-3 px-4 py-3 bg-red-50 text-red-600 rounded-xl hover:bg-red-100 transition-all font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Logout
            </a>
        </div>
    <a class="rs-workbench-nav" href="/workbench">Profile, calendar & teams <span aria-hidden="true">↗</span></a><div class="finance-sidebar-footer"><span class="finance-sidebar-status"></span><span>Connected workspace<small>Your people. Your sphere.</small></span></div></aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden relative">
        <div id="rs-dashboard-dots" aria-hidden="true"></div>
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6 z-30">
            <div class="flex items-center gap-4">
                <button class="md:hidden text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h2 id="pageTitle" class="text-xl font-bold text-gray-800">HR Dashboard</h2>
            </div>
            <div class="flex items-center gap-4">
                 <div class="text-right hidden sm:block">
                    <div class="text-sm font-bold text-gray-800"><%= hr.name || 'HR Admin' %></div>
                    <div class="text-xs text-gray-500"><%= hr.email || 'Human Resources' %></div>
                </div>
                <div class="w-10 h-10 bg-primary-100 rounded-full flex items-center justify-center text-primary-600 font-bold border-2 border-white shadow-sm">HR</div>
            </div>
        </header>

        <div class="rs-dot-scroll flex-1 overflow-y-auto p-6 bg-gray-50">

            <!-- Dashboard Section (Employee List) -->
            <div id="section-dashboard" class="section-content active">
                <div class="finance-welcome"><div><p class="finance-eyebrow">HR WORKSPACE</p><h1>Welcome back, <%= hr.name %><span>.</span></h1><p>Here’s what’s happening in your sphere today.</p></div><time><%= new Intl.DateTimeFormat('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'Asia/Kolkata'}).format(new Date()) %></time></div><div class="grid grid-cols-1 md:grid-cols-3 gap-6 finance-kpis mb-6">
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Total Employees</p>
                                <h3 class="text-2xl font-bold text-gray-900" id="stat-employees">...</h3>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Total Managers</p>
                                <h3 class="text-2xl font-bold text-gray-900" id="stat-managers">...</h3>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-600">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Pending Manager Tasks</p>
                                <h3 class="text-2xl font-bold text-gray-900" id="stat-manager-tasks">...</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <%- include('partials/finance-pulse') %>
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-100 flex justify-between items-center flex-wrap gap-4">
                        <h3 class="text-lg font-bold text-gray-900">Employee List</h3>
                        <div class="flex gap-2">
                             <button data-rs-click="hrDashboard-13" class="text-gray-500 hover:text-primary-600 p-2 rounded-lg transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                            <button data-rs-click="hrDashboard-14" class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 transition flex items-center gap-2 shadow-sm">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                Add Employee
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full rs-directory-table">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
                                    <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="employeeList" class="divide-y divide-gray-100"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Leave Application Section -->
            <div id="section-leave" class="section-content">
                <div class="max-w-3xl mx-auto">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="p-6 border-b border-gray-100">
                            <h3 class="text-lg font-bold text-gray-900">Apply for Leave</h3>
                            <p class="text-sm text-gray-500">Submit a leave request for yourself or on behalf of an employee.</p>
                        </div>
                        <div class="p-8">
                            <form id="leaveForm" class="space-y-6">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">From Date</label>
                                        <input type="date" id="leaveFrom" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none transition">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">To Date</label>
                                        <input type="date" id="leaveTo" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none transition">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Reason</label>
                                    <textarea id="leaveReason" rows="4" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none transition" placeholder="Please describe the reason for leave..."></textarea>
                                </div>
                                <div class="flex justify-end">
                                    <button type="submit" class="bg-primary-600 text-white px-6 py-2 rounded-lg hover:bg-primary-700 font-bold transition shadow-sm">Submit Request</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div id="leaveDetails" class="mt-8 hidden animate-fade-in-down">
                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                             <div class="p-6 border-b border-gray-100">
                                <h3 class="text-lg font-bold text-gray-900">Recent Leave Requests</h3>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="bg-gray-50">
                                        <tr>
