        async function loadComplaints() {
            const container = document.getElementById('complaintsTableContainer');
            container.innerHTML = '<p class="px-6 py-8 text-center text-gray-400 text-sm">Loading...</p>';
            try {
                const res  = await fetch('/api/complaints/all');
                const data = await res.json();
                if (!data.success) throw new Error(data.error);

                const complaints = data.complaints;
                if (!complaints || complaints.length === 0) {
                    container.innerHTML = '<p class="px-6 py-8 text-center text-gray-400 text-sm">No complaints filed yet.</p>';
                    return;
                }

                let rows = '';
                complaints.forEach(c => {
                    const date = new Date(c.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
                    const statusBadge = c.status === 'Pending'
                        ? '<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-700">Pending</span>'
                        : c.status === 'Reviewed'
                        ? '<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">Reviewed</span>'
                        : '<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Resolved</span>';

                    const fileBtn = c.attachmentPath
                        ? `<a href="/${c.attachmentPath.replace(/\\/g,'/')}" target="_blank" class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded hover:bg-gray-200 transition">
                               <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
                               ${c.attachmentName || 'View File'}
                           </a>`
                        : '<span class="text-xs text-gray-400">No file</span>';

                    rows += `
                        <tr class="hover:bg-gray-50">
                            <td class="px-5 py-4 text-sm font-medium text-gray-900">${escapeHtml(c.employeeName)}<br><span class="text-xs text-gray-400 font-normal">${escapeHtml(c.employeeEmail)}</span></td>
                            <td class="px-5 py-4 text-sm text-gray-600">${escapeHtml(c.managerName)}</td>
                            <td class="px-5 py-4 text-sm text-gray-600 max-w-xs"><div class="truncate" title="${escapeHtml(c.removalReason)}">${escapeHtml(c.removalReason)}</div></td>
                            <td class="px-5 py-4 text-sm text-gray-600 max-w-xs"><div class="truncate" title="${escapeHtml(c.complaintText)}">${escapeHtml(c.complaintText)}</div></td>
                            <td class="px-5 py-4">${fileBtn}</td>
                            <td class="px-5 py-4 text-xs text-gray-500">${date}</td>
                            <td class="px-5 py-4">${statusBadge}</td>
                            <td class="px-5 py-4">
                                <select data-rs-change="hrDashboard-32" data-rs-arg-0="${escapeHtml(c._id)}" class="text-xs border border-gray-300 rounded-lg px-2 py-1 focus:ring-1 focus:ring-blue-400">
                                    <option value="Pending"  ${c.status==='Pending'  ? 'selected':''}>Pending</option>
                                    <option value="Reviewed" ${c.status==='Reviewed' ? 'selected':''}>Reviewed</option>
                                    <option value="Resolved" ${c.status==='Resolved' ? 'selected':''}>Resolved</option>
                                </select>
                            </td>
                            <td class="px-5 py-4">
                                <input type="text" value="${c.hrNote || ''}" placeholder="Add note..." id="note_${escapeHtml(c._id)}"
                                    class="text-xs border border-gray-300 rounded-lg px-2 py-1 w-32 focus:ring-1 focus:ring-blue-400">
                                <button data-rs-click="hrDashboard-33" data-rs-arg-0="${escapeHtml(c._id)}" class="ml-1 text-xs text-blue-600 hover:underline">Save</button>
                            </td>
                        </tr>`;
                });

                container.innerHTML = `
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Employee</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Manager</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Removal Reason</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Complaint</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">File</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Update</th>
                                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">HR Note</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">${rows}</tbody>
                    </table>`;
            } catch (err) {
                console.error(err);
                container.innerHTML = '<p class="px-6 py-8 text-center text-red-400 text-sm">Failed to load complaints.</p>';
            }
        }

        async function updateComplaintStatus(complaintId, status) {
            try {
                const noteInput = document.getElementById('note_' + complaintId);
                const hrNote = noteInput ? noteInput.value : '';
                const res = await fetch('/api/complaints/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ complaintId, status, hrNote })
                });
                const data = await res.json();
                if (!data.success) alert('Failed to update status');
            } catch (err) {
                console.error(err);
            }
        }

        async function saveHrNote(complaintId) {
            const noteInput = document.getElementById('note_' + complaintId);
            const hrNote = noteInput ? noteInput.value : '';
            const selectEl = document.querySelector(`tr td select[onchange*="${complaintId}"]`);
            const status = selectEl ? selectEl.value : 'Pending';
            try {
                const res = await fetch('/api/complaints/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ complaintId, status, hrNote })
                });
                const data = await res.json();
                if (data.success) {
                    noteInput.style.borderColor = '#10b981';
                    setTimeout(() => noteInput.style.borderColor = '', 1500);
                }
            } catch (err) {
                console.error(err);
            }
        }

        // ── HR Transfer Assignments ────────────────────────────────────────
        async function loadHRTransfers() {
            try {
                const [transferRes, managerRes] = await Promise.all([
                    fetch('/api/transfer/hr-requests'),
                    fetch('/hr/managers')
                ]);
                const transferData = await transferRes.json();
                const managerData  = await managerRes.json();
                const container    = document.getElementById('hrTransferList');

                if (!transferData.success || !transferData.requests.length) {
                    container.innerHTML = '<p class="text-sm text-gray-400">No pending transfer requests to review.</p>';
                    return;
                }

                const managerOptions = (managerData.managers || [])
                    .map(m => `<option value="${escapeHtml(m._id)}">${escapeHtml(m.name)}</option>`)
                    .join('');

                container.innerHTML = transferData.requests.map(r => `
                    <div class="border border-gray-200 rounded-xl p-5 mb-3">
                        <div class="flex items-start justify-between mb-3">
                            <div>
                                <p class="text-sm font-bold text-gray-900">${escapeHtml(r.employeeName)}</p>
                                <p class="text-xs text-gray-500">${escapeHtml(r.employeeEmail)}</p>
                                <p class="text-sm text-gray-700 mt-2"><span class="font-medium">Current Manager:</span> ${escapeHtml(r.currentManagerName)}</p>
                                <p class="text-sm text-gray-700"><span class="font-medium">Reason:</span> ${escapeHtml(r.reason)}</p>
                                ${r.managerNote ? `<p class="text-xs text-gray-500 mt-1">Manager note: <em>${escapeHtml(r.managerNote)}</em></p>` : ''}
                                <p class="text-xs text-gray-400 mt-1">Requested: ${new Date(r.createdAt).toLocaleDateString('en-IN')}</p>
                            </div>
                            <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-green-100 text-green-700">Manager Approved</span>
                        </div>
                        <div class="flex flex-wrap gap-2 items-center mt-3">
                            <select id="newMgr_${escapeHtml(r._id)}" class="text-sm px-3 py-1.5 border border-gray-300 rounded-lg min-w-[180px]">
                                <option value="">Select new manager...</option>
                                ${managerOptions}
                            </select>
                            <input id="hrNote_${escapeHtml(r._id)}" type="text" placeholder="Optional note..."
                                class="text-sm px-3 py-1.5 border border-gray-300 rounded-lg flex-1 min-w-[160px]">
                            <button data-rs-click="hrDashboard-34" data-rs-arg-0="${escapeHtml(r._id)}"
                                class="px-4 py-1.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition">Assign & Transfer</button>
                            <button data-rs-click="hrDashboard-35" data-rs-arg-0="${escapeHtml(r._id)}"
                                class="px-4 py-1.5 bg-red-500 text-white text-sm font-medium rounded-lg hover:bg-red-600 transition">Reject</button>
                        </div>
                        <p id="hrTransferMsg_${escapeHtml(r._id)}" class="text-xs mt-2 hidden"></p>
                    </div>
                `).join('');
            } catch (err) {
                console.error('HR transfer load error:', err);
            }
        }

        async function assignTransfer(transferId) {
            const newManagerId = document.getElementById(`newMgr_${transferId}`)?.value;
            const hrNote       = document.getElementById(`hrNote_${transferId}`)?.value || '';
            const msg          = document.getElementById(`hrTransferMsg_${transferId}`);

            if (!newManagerId) {
                if (msg) { msg.textContent = 'Please select a new manager first.'; msg.classList.remove('hidden'); msg.className = 'text-xs mt-2 text-red-600'; }
                return;
            }
            try {
                const res  = await fetch('/api/transfer/hr-assign', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ transferId, newManagerId, hrNote })
                });
                const data = await res.json();
                if (msg) { msg.classList.remove('hidden'); }
                if (data.success) {
                    if (msg) { msg.textContent = '\u2705 ' + data.message; msg.className = 'text-xs mt-2 text-green-600'; }
                    setTimeout(() => loadHRTransfers(), 1200);
                } else {
                    if (msg) { msg.textContent = data.error || 'Failed.'; msg.className = 'text-xs mt-2 text-red-600'; }
                }
            } catch (err) {
                console.error('Assign transfer error:', err);
            }
        }

        async function rejectTransferHR(transferId) {
            const hrNote = document.getElementById(`hrNote_${transferId}`)?.value || '';
            const msg    = document.getElementById(`hrTransferMsg_${transferId}`);
            try {
                const res  = await fetch('/api/transfer/hr-reject', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ transferId, hrNote })
                });
                const data = await res.json();
                if (msg) { msg.classList.remove('hidden'); }
                if (data.success) {
                    if (msg) { msg.textContent = '\u2705 Request rejected.'; msg.className = 'text-xs mt-2 text-green-600'; }
                    setTimeout(() => loadHRTransfers(), 1000);
                } else {
                    if (msg) { msg.textContent = data.error || 'Failed.'; msg.className = 'text-xs mt-2 text-red-600'; }
                }
            } catch (err) {
                console.error('HR reject error:', err);
            }
        }

        function showHRTransferPanel() {
            // Hide all sections
            document.querySelectorAll('.section-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('bg-primary-50', 'text-primary-600', 'border-primary-600');
                el.classList.add('text-gray-600', 'hover:bg-gray-50', 'border-transparent');
            });
            // Hide other panel
            document.getElementById('hrPerformancePanel').classList.add('hidden');
            // Show this panel + highlight nav
            document.getElementById('hrTransferPanel').classList.remove('hidden');
            document.querySelectorAll('[data-section="transfer"]').forEach(el => {
                el.classList.add('bg-primary-50', 'text-primary-600', 'border-primary-600');
                el.classList.remove('text-gray-600', 'hover:bg-gray-50', 'border-transparent');
            });
            loadHRTransfers();
        }

        // ── HR Performance Reviews ───────────────────────────────────────────
        var _allHRReviews = [];

        function showHRPerformancePanel() {
            // Hide all sections
            document.querySelectorAll('.section-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('bg-primary-50', 'text-primary-600', 'border-primary-600');
                el.classList.add('text-gray-600', 'hover:bg-gray-50', 'border-transparent');
            });
            // Hide other panel
            document.getElementById('hrTransferPanel').classList.add('hidden');
            // Show this panel + highlight nav
            document.getElementById('hrPerformancePanel').classList.remove('hidden');
            document.querySelectorAll('[data-section="performance"]').forEach(el => {
                el.classList.add('bg-primary-50', 'text-primary-600', 'border-primary-600');
                el.classList.remove('text-gray-600', 'hover:bg-gray-50', 'border-transparent');
            });
            loadHRAllReviews();
        }

        async function loadHRAllReviews() {
            var listEl = document.getElementById('hr-reviews-list');
            listEl.innerHTML = '<p class="text-sm text-gray-400">Loading...</p>';
            try {
                var res  = await fetch('/api/performance/all');
                var data = await res.json();
                if (!data.success || !data.reviews.length) {
                    listEl.innerHTML = '<p class="text-sm text-gray-400">No performance reviews submitted yet.</p>';
                    return;
                }
                _allHRReviews = data.reviews;
                updateHRStats(data.reviews);
                renderHRReviews(data.reviews);
            } catch(err) {
                listEl.innerHTML = '<p class="text-sm text-red-400">Failed to load.</p>';
            }
        }

        function filterHRReviews() {
            var filter = document.getElementById('hr-perf-filter').value;
            var filtered = filter ? _allHRReviews.filter(function(r){return r.rating==filter;}) : _allHRReviews;
            renderHRReviews(filtered);
        }

        function updateHRStats(reviews) {
            document.getElementById('hr-perf-total').textContent = reviews.length;
            var avg = (reviews.reduce(function(s,r){return s+r.rating;},0)/reviews.length).toFixed(1);
            document.getElementById('hr-perf-avg').textContent = avg+'&#9733;';
            document.getElementById('hr-perf-excellent').textContent = reviews.filter(function(r){return r.rating===5;}).length;
            document.getElementById('hr-perf-poor').textContent = reviews.filter(function(r){return r.rating<=2;}).length;
        }

        function renderHRReviews(reviews) {
            var listEl = document.getElementById('hr-reviews-list');
            if (!reviews.length) { listEl.innerHTML='<p class="text-sm text-gray-400">No reviews match this filter.</p>'; return; }
            var ratingLabels3 = {1:'Poor',2:'Below Average',3:'Average',4:'Good',5:'Excellent'};
            var ratingBg = {1:'bg-red-100 text-red-700',2:'bg-orange-100 text-orange-700',3:'bg-amber-100 text-amber-700',4:'bg-blue-100 text-blue-700',5:'bg-green-100 text-green-700'};
            listEl.innerHTML = '<div class="overflow-x-auto"><table class="min-w-full divide-y divide-gray-200">'+
                '<thead class="bg-gray-50"><tr>'+
                '<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Employee</th>'+
                '<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Period</th>'+
                '<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Rating</th>'+
                '<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Reviewer</th>'+
                '<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Comments</th>'+
                '<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>'+
                '</tr></thead>'+
                '<tbody class="bg-white divide-y divide-gray-100">'+
                reviews.map(function(r){
                    var emp = r.employeeId;
                    return '<tr class="hover:bg-gray-50">'+
                        '<td class="px-4 py-3"><p class="text-sm font-semibold text-gray-900">'+(emp&&emp.name?emp.name:'Unknown')+'</p><p class="text-xs text-gray-400">'+(emp&&emp.email?emp.email:'')+'</p></td>'+
                        '<td class="px-4 py-3 text-sm text-gray-600 whitespace-nowrap">'+r.period+'</td>'+
                        '<td class="px-4 py-3 whitespace-nowrap"><span class="px-2 py-0.5 text-xs font-bold rounded-full '+ratingBg[r.rating]+'">'+r.rating+'&#9733; '+ratingLabels3[r.rating]+'</span></td>'+
                        '<td class="px-4 py-3 text-xs text-gray-600 whitespace-nowrap">'+r.reviewerName+'<br><span class="text-gray-400">'+r.reviewerModel+'</span></td>'+
                        '<td class="px-4 py-3 text-xs text-gray-600 max-w-xs">'+r.comments.substring(0,100)+(r.comments.length>100?'...':'')+'</td>'+
                        '<td class="px-4 py-3 text-xs text-gray-400 whitespace-nowrap">'+new Date(r.createdAt).toLocaleDateString('en-IN')+'</td>'+
                    '</tr>';
                }).join('')+
                '</tbody></table></div>';
        }

</script>

    <!-- ══ ANNOUNCEMENT SYSTEM JS ══════════════════════════════════════════ -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
    (function() {
        /* ── Socket connection ─────────────────────────────────────────── */
        const _socket = typeof io !== 'undefined' ? io() : null;
        let _annPanelOpen = false;

        /* ── On socket connect: request unread count immediately ──────── */
        if (_socket) {
            _socket.on('connect', function() {
                _socket.emit('notifications:get_count');
            });

            /* Real-time: new announcement arrived ─────────────────────── */
            _socket.on('announcement:new', function(ann) {
                // Increment badge
                const badge = document.getElementById('ann-badge');
                if (badge) {
                    const cur = parseInt(badge.textContent) || 0;
                    _setBadge(cur + 1);
                }
                // Prepend to list if panel is open
                if (_annPanelOpen) {
                    _prependAnnouncement(ann);
                } else {
                    // Reload list next time panel opens
                    _annListDirty = true;
                }
                // Flash button
                const btn = document.getElementById('ann-toggle-btn');
                if (btn) {
                    btn.classList.add('bg-blue-100');
                    setTimeout(function() { btn.classList.remove('bg-blue-100'); }, 1500);
                }
            });
        }

        let _annListDirty = true; // force first load

        /* ── Toggle panel open/close ───────────────────────────────────── */
        window.toggleAnnouncementPanel = function() {
            _annPanelOpen = !_annPanelOpen;
            const panel   = document.getElementById('ann-panel');
            const chevron = document.getElementById('ann-chevron');
            if (!panel) return;

            if (_annPanelOpen) {
                panel.classList.remove('hidden');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                if (_annListDirty) _loadAnnouncementList();
                // Mark seen after 1 second (gives user time to read)
                setTimeout(markAllAnnouncementsSeen, 1000);
            } else {
                panel.classList.add('hidden');
                if (chevron) chevron.style.transform = '';
            }
        };

        /* ── Load announcements from API ───────────────────────────────── */
        async function _loadAnnouncementList() {
            const list = document.getElementById('ann-list');
            if (!list) return;
            list.innerHTML = '<p class="text-xs text-gray-400 px-4 py-3">Loading…</p>';
            try {
                const res  = await fetch('/api/overview/announcements');
                const data = await res.json();
                if (!data.success || !data.announcements || data.announcements.length === 0) {
                    list.innerHTML = '<p class="text-xs text-gray-500 px-4 py-3 text-center">No announcements yet.</p>';
                    return;
                }
                list.innerHTML = data.announcements.map(function(a) {
                    return _annCard(a);
                }).join('');
                _annListDirty = false;
            } catch(e) {
                list.innerHTML = '<p class="text-xs text-red-400 px-4 py-3">Failed to load.</p>';
            }
        }

        /* ── Prepend a single new announcement card ────────────────────── */
        function _prependAnnouncement(ann) {
            const list = document.getElementById('ann-list');
            if (!list) return;
            // Remove "no announcements" placeholder if present
            const placeholder = list.querySelector('p');
            if (placeholder) placeholder.remove();
            const div = document.createElement('div');
            div.innerHTML = _annCard(ann);
            list.insertBefore(div.firstChild, list.firstChild);
        }

        /* ── Build HTML card for one announcement — clickable ─────────── */
        function _annCard(a) {
            const dateStr = a.date ? new Date(a.date).toLocaleDateString('en-IN', {
                day: 'numeric', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            }) : '';
            const titleEsc   = _esc(a.title);
            const msgEsc     = _esc(a.message);
            const attachHtml = a.attachmentUrl
                ? '<a href="' + a.attachmentUrl + '" target="_blank" class="mt-2 inline-flex items-center gap-1 text-primary-600 hover:underline text-xs" data-rs-click="hrDashboard-36"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>View Attachment</a>'
                : '';
            const dataAttach = a.attachmentUrl ? ' data-attach="' + _esc(a.attachmentUrl) + '"' : '';
            return '<div class="px-4 py-3 hover:bg-blue-100 transition-colors cursor-pointer" ' +
                       'data-rs-click="hrDashboard-37" ' +
                       'data-title="' + titleEsc + '" ' +
                       'data-msg="' + msgEsc + '" ' +
                       'data-date="' + dateStr + '"' + dataAttach + '>' +
                       '<p class="text-xs font-bold text-gray-800 leading-snug">' + titleEsc + '</p>' +
                       '<p class="text-xs text-gray-500 mt-0.5 leading-snug line-clamp-2">' + msgEsc + '</p>' +
                       attachHtml +
                       '<p class="text-xs text-gray-400 mt-1">' + dateStr + '</p>' +
                   '</div>';
        }

        window.openAnnModal = function(el) {
            const title  = el.getAttribute('data-title')  || '';
            const msg    = el.getAttribute('data-msg')    || '';
            const date   = el.getAttribute('data-date')   || '';
            const attach = el.getAttribute('data-attach') || '';
            document.getElementById('ann-modal-title').textContent = title;
            document.getElementById('ann-modal-msg').textContent   = msg;
            document.getElementById('ann-modal-date').textContent  = date;
            const attachEl = document.getElementById('ann-modal-attach');
            if (attach) { attachEl.href = attach; attachEl.classList.remove('hidden'); }
            else { attachEl.classList.add('hidden'); }
            document.getElementById('ann-modal').classList.remove('hidden');
        };

        window.closeAnnModal = function() {
            document.getElementById('ann-modal').classList.add('hidden');
        };

        /* ── Mark all announcements as seen (resets badge) ─────────────── */
        window.markAllAnnouncementsSeen = async function() {
            try {
                await fetch('/api/overview/announcements/mark-seen', { method: 'POST' });
                _setBadge(0);
            } catch(e) {}
        };

        /* ── Set badge count ───────────────────────────────────────────── */
        function _setBadge(n) {
            const badge = document.getElementById('ann-badge');
            if (!badge) return;
            if (n > 0) {
                badge.textContent = n > 99 ? '99+' : n;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
                badge.textContent = '0';
            }
        }

        /* ── HTML-escape helper ────────────────────────────────────────── */
        function _esc(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        /* ── Poll unread count on page load (fallback if socket fails) ─── */
        async function _pollUnreadCount() {
            try {
                const res  = await fetch('/api/overview/announcements/unread-count');
                const data = await res.json();
                if (data.success) _setBadge(data.count);
            } catch(e) {}
        }

        /* ── Init ──────────────────────────────────────────────────────── */
        document.addEventListener('DOMContentLoaded', function() {
            _pollUnreadCount();
        });

    })();
    </script>
    <!-- ══ END ANNOUNCEMENT SYSTEM JS ══════════════════════════════════════ -->

