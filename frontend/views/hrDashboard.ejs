    <script>
        // Section Navigation
        function showSection(sectionId) {
            // Hide panels when switching to a section
            var perfPanel = document.getElementById('hrPerformancePanel');
            var transPanel = document.getElementById('hrTransferPanel');
            if(perfPanel) perfPanel.classList.add('hidden');
            if(transPanel) transPanel.classList.add('hidden');

            document.querySelectorAll('.section-content').forEach(el => el.classList.remove('active'));
            document.getElementById(`section-${sectionId}`).classList.add('active');

            document.querySelectorAll('.nav-item').forEach(el => {
                if(el.dataset.section === sectionId) {
                    el.classList.add('bg-primary-50', 'text-primary-600', 'border-primary-600');
                    el.classList.remove('text-gray-600', 'hover:bg-gray-50', 'border-transparent');
                } else {
                    el.classList.remove('bg-primary-50', 'text-primary-600', 'border-primary-600');
                    el.classList.add('text-gray-600', 'hover:bg-gray-50', 'border-transparent');
                }
            });

            if (sectionId === 'calendar' && calendar) {
                setTimeout(() => calendar.render(), 100);
            }
        }

        // Modal Management
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }
        function closeModal(modalId) {
