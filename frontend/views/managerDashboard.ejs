<script>
    let removeTargetEmployeeId = null;

    function openRemoveEmployeeModal(employeeId, employeeName) {
        removeTargetEmployeeId = employeeId;
        document.getElementById('removeEmployeeName').textContent = employeeName;
        document.getElementById('removalReasonInput').value = '';
        document.getElementById('removeEmployeeModal').classList.remove('hidden');
    }

    function closeRemoveEmployeeModal() {
        removeTargetEmployeeId = null;
        document.getElementById('removeEmployeeModal').classList.add('hidden');
    }

    async function confirmRemoveEmployee() {
        const reason = document.getElementById('removalReasonInput').value.trim();
        if (!reason || reason.length < 5) {
            alert('Please provide a reason of at least 5 characters.');
            return;
        }
        if (!removeTargetEmployeeId) return;

        const btn = document.querySelector('#removeEmployeeModal button[data-rs-click="managerDashboard-61"]');
        btn.textContent = 'Removing...';
        btn.disabled = true;

        try {
            const res = await fetch('/manager/removeEmployee', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ employeeId: removeTargetEmployeeId, reason })
            });
            const data = await res.json();

            if (data.success) {
                closeRemoveEmployeeModal();
                showToast('Employee removed and notified by email.', 'success');
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast(data.error || 'Failed to remove employee.', 'error');
            }
        } catch (err) {
            showToast('Server error. Please try again.', 'error');
        } finally {
            btn.textContent = 'Confirm Removal';
            btn.disabled = false;
        }
    }
        // ── Performance Reviews (Manager) ───────────────────────────────────
        var _perfSuggestions = null;
        var ratingLabels = {1:'Poor',2:'Below Average',3:'Average',4:'Good',5:'Excellent'};

        function showPerformancePanel() {
            // Hide all sections and panels
            ['dashboard','team','assignTask','reviewTasks','allTasks','leaveApprovals','reportReviews','hrTasks','attendance','team-attendance'].forEach(function(id){
                var el = document.getElementById(id+'Section');
                if(el) el.classList.add('hidden');
                var nav = document.getElementById('nav-'+id);
                if(nav) nav.classList.remove('active','bg-blue-50','text-primary-600','border-r-4','border-primary-600');
            });
            document.getElementById('transferRequestsPanel').classList.add('hidden');
            document.getElementById('nav-transfer') && document.getElementById('nav-transfer').classList.remove('active','text-primary-600');

            // Show performance panel
            document.getElementById('performancePanel').classList.remove('hidden');
            document.getElementById('nav-performance').classList.add('active','text-primary-600');
            loadTeamForReview();
            loadManagerGivenReviews();
            populatePerfPeriods();
        }

        function showTransferPanel() {
            // Hide all sections and panels
            ['dashboard','team','assignTask','reviewTasks','allTasks','leaveApprovals','reportReviews','hrTasks','attendance','team-attendance'].forEach(function(id){
                var el = document.getElementById(id+'Section');
                if(el) el.classList.add('hidden');
                var nav = document.getElementById('nav-'+id);
                if(nav) nav.classList.remove('active','bg-blue-50','text-primary-600','border-r-4','border-primary-600');
            });
            document.getElementById('performancePanel').classList.add('hidden');
            document.getElementById('nav-performance') && document.getElementById('nav-performance').classList.remove('active','text-primary-600');

            // Show transfer panel
            document.getElementById('transferRequestsPanel').classList.remove('hidden');
            document.getElementById('nav-transfer').classList.add('active','text-primary-600');
            loadTransferRequests();
        }

        function populatePerfPeriods() {
            var sel = document.getElementById('perf-period');
            var now = new Date();
            var opts = ['<option value="">Select period...</option>'];
            for (var i=0;i<8;i++) {
                var d = new Date(now.getFullYear(), now.getMonth()-i, 1);
                var val = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
                var lbl = d.toLocaleDateString('en-IN',{year:'numeric',month:'long'});
                opts.push('<option value="'+val+'">'+lbl+'</option>');
            }
            sel.innerHTML = opts.join('');
        }

        async function loadTeamForReview() {
            try {
                var res  = await fetch('/api/performance/team-employees');
                var data = await res.json();
                var sel  = document.getElementById('perf-employeeId');
                if (!data.success || !data.employees.length) {
                    sel.innerHTML = '<option value="">No team members found</option>';
                    document.getElementById('perf-team').textContent = '0';
                    return;
                }
                document.getElementById('perf-team').textContent = data.employees.length;
                sel.innerHTML = '<option value="">Select employee...</option>' +
                    data.employees.map(function(e){return '<option value="'+e._id+'">'+e.name+'</option>';}).join('');
            } catch(err){console.error('loadTeamForReview error:',err);}
        }

        async function loadAutoSuggestions() {
            var empId = document.getElementById('perf-employeeId').value;
            var strip = document.getElementById('perf-suggestion-strip');
            if (!empId) { strip.classList.add('hidden'); return; }
            try {
                var res  = await fetch('/api/performance/suggestions/'+empId);
                var data = await res.json();
                if (!data.success) { strip.classList.add('hidden'); return; }
                _perfSuggestions = data.suggestions;
                strip.classList.remove('hidden');
                document.getElementById('perf-stats-text').innerHTML =
                    '<p>Tasks: <strong>'+data.stats.approvedTasks+'/'+data.stats.totalTasks+'</strong> approved ('+data.stats.completionRate+'% completion)</p>'+
                    '<p>Overdue: <strong>'+data.stats.overdueTasks+'</strong> | Reports: <strong>'+data.stats.totalReports+'</strong> | Hours: <strong>'+data.stats.totalHours+'</strong></p>'+
                    '<p class="mt-1 font-semibold text-indigo-700">Suggested: '+'&#9733;'.repeat(data.suggestions.rating)+' ('+ratingLabels[data.suggestions.rating]+')</p>';
            } catch(err){strip.classList.add('hidden');}
        }

        function applySuggestions() {
            if (!_perfSuggestions) return;
            setRating(_perfSuggestions.rating);
            document.getElementById('perf-comments').value     = _perfSuggestions.comments;
            document.getElementById('perf-strengths').value    = _perfSuggestions.strengths;
            document.getElementById('perf-improvements').value = _perfSuggestions.improvements;
        }

        function setRating(n) {
            document.getElementById('perf-rating').value = n;
            document.getElementById('rating-label').textContent = ratingLabels[n]||'';
            document.querySelectorAll('.star-btn').forEach(function(btn){
                btn.style.color = parseInt(btn.dataset.star) <= n ? '#f59e0b' : '#d1d5db';
            });
        }

        function addGoalRow(val) {
            var c = document.getElementById('goals-container');
            var d = document.createElement('div');
            d.className = 'flex gap-2';
            d.innerHTML = '<input type="text" placeholder="Goal description..." value="'+(val||'')+'" class="flex-1 px-3 py-1.5 border border-gray-300 rounded-lg text-sm goal-input">'+
                          '<button type="button" data-rs-click="managerDashboard-62" class="text-red-400 hover:text-red-600 font-bold px-2 text-lg">&times;</button>';
            c.appendChild(d);
        }

        async function submitPerformanceReview() {
            var msgEl        = document.getElementById('perf-form-msg');
            var employeeId   = document.getElementById('perf-employeeId').value;
            var period       = document.getElementById('perf-period').value;
            var rating       = document.getElementById('perf-rating').value;
            var comments     = document.getElementById('perf-comments').value.trim();
            var strengths    = document.getElementById('perf-strengths').value.trim();
            var improvements = document.getElementById('perf-improvements').value.trim();
            var goals        = Array.from(document.querySelectorAll('.goal-input'))
                                   .map(function(i){return {description:i.value.trim(),status:'Pending'};})
                                   .filter(function(g){return g.description;});
            msgEl.classList.add('hidden');
            if (!employeeId||!period||!rating||!comments) {
                msgEl.className='bg-red-50 border border-red-200 rounded-lg px-4 py-2 text-sm text-red-700 mb-3';
                msgEl.textContent='Fill in all required fields and select a star rating.';
                msgEl.classList.remove('hidden'); return;
            }
            try {
                var res = await fetch('/api/performance/create',{
                    method:'POST',headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({employeeId,period,rating:Number(rating),comments,strengths,improvements,goals})
                });
                var data = await res.json();
                if (data.success) {
                    ['perf-employeeId','perf-period','perf-rating','perf-comments','perf-strengths','perf-improvements'].forEach(function(id){
                        document.getElementById(id).value='';
                    });
                    document.getElementById('goals-container').innerHTML='';
                    document.getElementById('perf-suggestion-strip').classList.add('hidden');
                    setRating(0);
                    loadManagerGivenReviews();
                    msgEl.className='bg-green-50 border border-green-200 rounded-lg px-4 py-2 text-sm text-green-700 mb-3';
                    msgEl.textContent='Review submitted for '+(data.employeeName||'employee')+'.';
                    msgEl.classList.remove('hidden');
                    setTimeout(function(){msgEl.classList.add('hidden');},3000);
                } else {
                    msgEl.className='bg-red-50 border border-red-200 rounded-lg px-4 py-2 text-sm text-red-700 mb-3';
                    msgEl.textContent=data.error||'Failed to submit.';
                    msgEl.classList.remove('hidden');
                }
            } catch(err){
                msgEl.className='bg-red-50 border border-red-200 rounded-lg px-4 py-2 text-sm text-red-700 mb-3';
                msgEl.textContent='Network error.'; msgEl.classList.remove('hidden');
            }
        }

        async function loadManagerGivenReviews() {
            var c = document.getElementById('perf-given-list');
            try {
                var res  = await fetch('/api/performance/manager-reviews');
                var data = await res.json();
                if (!data.success||!data.reviews.length) {
                    c.innerHTML='<p class="p-6 text-sm text-gray-400">No reviews submitted yet.</p>';
                    document.getElementById('perf-total').textContent='0';
                    document.getElementById('perf-avg').textContent='-';
                    return;
                }
                document.getElementById('perf-total').textContent=data.reviews.length;
                var avg=(data.reviews.reduce(function(s,r){return s+r.rating;},0)/data.reviews.length).toFixed(1);
                document.getElementById('perf-avg').textContent=avg+'&#9733;';
                c.innerHTML=data.reviews.map(function(r){
                    var stars='&#9733;'.repeat(r.rating)+'&#9734;'.repeat(5-r.rating);
                    var emp=r.employeeId;
                    return '<div class="px-5 py-4 border-b border-gray-50 last:border-0">'+
                        '<div class="flex items-start justify-between mb-1">'+
                            '<div><p class="text-sm font-semibold text-gray-900">'+(emp&&emp.name?emp.name:'Unknown')+'</p>'+
                            '<p class="text-xs text-gray-400">'+(emp&&emp.email?emp.email:'')+'</p></div>'+
                            '<span class="text-amber-400 font-bold text-sm">'+stars+'</span>'+
                        '</div>'+
                        '<p class="text-xs text-indigo-600 font-medium mb-1">'+r.period+'</p>'+
                        '<p class="text-xs text-gray-600">'+r.comments+'</p>'+
                        (r.strengths?'<p class="text-xs text-green-700 mt-1">Strengths: '+r.strengths.substring(0,80)+'</p>':'')+
                        (r.improvements?'<p class="text-xs text-amber-700">Growth: '+r.improvements.substring(0,80)+'</p>':'')+
                        '<p class="text-xs text-gray-300 mt-1">'+new Date(r.createdAt).toLocaleDateString('en-IN')+'</p>'+
                    '</div>';
                }).join('');
            } catch(err){c.innerHTML='<p class="p-6 text-sm text-red-400">Failed to load.</p>';}
        }

</script>


    <!-- ══ ANNOUNCEMENT SYSTEM JS ══════════════════════════════════════════ -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
    (function() {
        /* ── Socket connection ─────────────────────────────────────────── */
        const _socket = typeof io !== 'undefined' ? io() : null;
        let _annPanelOpen = false;

        /* ── On socket connect: request unread count immediately ──────── */
        if (_socket) {
            _socket.on('connect', function() {
                _socket.emit('notifications:get_count');
            });

            /* Real-time: new announcement arrived ─────────────────────── */
            _socket.on('announcement:new', function(ann) {
                // Increment badge
                const badge = document.getElementById('ann-badge');
                if (badge) {
                    const cur = parseInt(badge.textContent) || 0;
                    _setBadge(cur + 1);
                }
                // Prepend to list if panel is open
                if (_annPanelOpen) {
                    _prependAnnouncement(ann);
                } else {
                    // Reload list next time panel opens
                    _annListDirty = true;
                }
                // Flash button
                const btn = document.getElementById('ann-toggle-btn');
                if (btn) {
                    btn.classList.add('bg-blue-100');
                    setTimeout(function() { btn.classList.remove('bg-blue-100'); }, 1500);
                }
            });
        }

        let _annListDirty = true; // force first load

        /* ── Toggle panel open/close ───────────────────────────────────── */
        window.toggleAnnouncementPanel = function() {
            _annPanelOpen = !_annPanelOpen;
            const panel   = document.getElementById('ann-panel');
            const chevron = document.getElementById('ann-chevron');
            if (!panel) return;

            if (_annPanelOpen) {
                panel.classList.remove('hidden');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                if (_annListDirty) _loadAnnouncementList();
                // Mark seen after 1 second (gives user time to read)
                setTimeout(markAllAnnouncementsSeen, 1000);
            } else {
                panel.classList.add('hidden');
                if (chevron) chevron.style.transform = '';
            }
        };

        /* ── Load announcements from API ───────────────────────────────── */
        async function _loadAnnouncementList() {
            const list = document.getElementById('ann-list');
            if (!list) return;
            list.innerHTML = '<p class="text-xs text-gray-400 px-4 py-3">Loading…</p>';
            try {
                const res  = await fetch('/api/overview/announcements');
                const data = await res.json();
                if (!data.success || !data.announcements || data.announcements.length === 0) {
                    list.innerHTML = '<p class="text-xs text-gray-500 px-4 py-3 text-center">No announcements yet.</p>';
                    return;
                }
                list.innerHTML = data.announcements.map(function(a) {
                    return _annCard(a);
                }).join('');
                _annListDirty = false;
            } catch(e) {
                list.innerHTML = '<p class="text-xs text-red-400 px-4 py-3">Failed to load.</p>';
            }
        }

        /* ── Prepend a single new announcement card ────────────────────── */
        function _prependAnnouncement(ann) {
            const list = document.getElementById('ann-list');
            if (!list) return;
            // Remove "no announcements" placeholder if present
            const placeholder = list.querySelector('p');
            if (placeholder) placeholder.remove();
            const div = document.createElement('div');
            div.innerHTML = _annCard(ann);
            list.insertBefore(div.firstChild, list.firstChild);
        }

        /* ── Build HTML card for one announcement — clickable ─────────── */
        function _annCard(a) {
            const dateStr = a.date ? new Date(a.date).toLocaleDateString('en-IN', {
                day: 'numeric', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            }) : '';
            const titleEsc   = _esc(a.title);
            const msgEsc     = _esc(a.message);
            const attachHtml = a.attachmentUrl
                ? '<a href="' + a.attachmentUrl + '" target="_blank" class="mt-2 inline-flex items-center gap-1 text-primary-600 hover:underline text-xs" data-rs-click="managerDashboard-63"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>View Attachment</a>'
                : '';
            // Store data on the element so openAnnModal can read it
            const dataAttach = a.attachmentUrl ? ' data-attach="' + _esc(a.attachmentUrl) + '"' : '';
            return '<div class="px-4 py-3 hover:bg-blue-100 transition-colors cursor-pointer" ' +
                       'data-rs-click="managerDashboard-64" ' +
                       'data-title="' + titleEsc + '" ' +
                       'data-msg="' + msgEsc + '" ' +
                       'data-date="' + dateStr + '"' + dataAttach + '>' +
                       '<p class="text-xs font-bold text-gray-800 leading-snug">' + titleEsc + '</p>' +
                       '<p class="text-xs text-gray-500 mt-0.5 leading-snug line-clamp-2">' + msgEsc + '</p>' +
                       attachHtml +
                       '<p class="text-xs text-gray-400 mt-1">' + dateStr + '</p>' +
                   '</div>';
        }

        /* ── Open announcement detail modal ─────────────────────────────── */
        window.openAnnModal = function(el) {
            const title  = el.getAttribute('data-title')  || '';
            const msg    = el.getAttribute('data-msg')    || '';
            const date   = el.getAttribute('data-date')   || '';
            const attach = el.getAttribute('data-attach') || '';

            document.getElementById('ann-modal-title').textContent  = title;
            document.getElementById('ann-modal-msg').textContent    = msg;
            document.getElementById('ann-modal-date').textContent   = date;

            const attachEl = document.getElementById('ann-modal-attach');
            if (attach) {
                attachEl.href = attach;
                attachEl.classList.remove('hidden');
            } else {
                attachEl.classList.add('hidden');
            }
            document.getElementById('ann-modal').classList.remove('hidden');
        };

        window.closeAnnModal = function() {
            document.getElementById('ann-modal').classList.add('hidden');
        };

        /* ── Mark all announcements as seen (resets badge) ─────────────── */
        window.markAllAnnouncementsSeen = async function() {
            try {
                await fetch('/api/overview/announcements/mark-seen', { method: 'POST' });
                _setBadge(0);
            } catch(e) {}
        };

        /* ── Set badge count ───────────────────────────────────────────── */
        function _setBadge(n) {
            const badge = document.getElementById('ann-badge');
            if (!badge) return;
            if (n > 0) {
                badge.textContent = n > 99 ? '99+' : n;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
                badge.textContent = '0';
            }
        }

        /* ── HTML-escape helper ────────────────────────────────────────── */
        function _esc(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        /* ── Poll unread count on page load (fallback if socket fails) ─── */
        async function _pollUnreadCount() {
            try {
                const res  = await fetch('/api/overview/announcements/unread-count');
                const data = await res.json();
                if (data.success) _setBadge(data.count);
            } catch(e) {}
        }

        /* ── Init ──────────────────────────────────────────────────────── */
        document.addEventListener('DOMContentLoaded', function() {
            _pollUnreadCount();
        });

    })();
    </script>
