        // ── Attendance System ── //
        const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
        let attInterval = null;

        function formatDuration(ci, co) {
            if (!ci||ci==='-'||!co||co==='-') return '--:--:--';
            const ts = t => { const [h,m,s]=t.split(':').map(Number); return h*3600+m*60+s; };
            let d=ts(co)-ts(ci); if(d<0)d+=86400;
            return [Math.floor(d/3600),Math.floor((d%3600)/60),d%60].map(n=>String(n).padStart(2,'0')).join(':');
        }

        function startLiveTimer(ci) {
            document.getElementById('attLiveTimer').classList.remove('hidden');
            if (attInterval) clearInterval(attInterval);
            const ts = t => { const [h,m,s]=t.split(':').map(Number); return h*3600+m*60+s; };
            const start = ts(ci);
            attInterval = setInterval(() => {
                const now = new Date();
                let d = (now.getHours()*3600+now.getMinutes()*60+now.getSeconds()) - start;
                if(d<0)d=0;
                document.getElementById('attTimerDisplay').innerText = [Math.floor(d/3600),Math.floor((d%3600)/60),d%60].map(n=>String(n).padStart(2,'0')).join(':');
            }, 1000);
        }

