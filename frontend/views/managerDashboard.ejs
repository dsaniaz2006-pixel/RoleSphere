<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/premium-head') %>
<script src="/vendor/purify.min.js"></script><script src="/js/ui.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard | RoleSphere</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/rolesphere-redesign.css">
    <link rel="stylesheet" href="/css/dashboard-background.css">
    <script defer src="/js/dashboard-background.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        const MY_USER_ID = <%- jsonForScript(manager._id) %>;
        const MY_USER_MODEL = 'Manager';
    </script>
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .sidebar-link.active { background-color: #eff6ff; color: #2563eb; border-right: 3px solid #2563eb; }

        /* Toast Notification */
        .toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 50; }
        .toast {
            min-width: 250px;
            background: white;
            border-left: 4px solid;
            padding: 16px;
            margin-bottom: 10px;
            border-radius: 4px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
            display: flex;
            align-items: center;
        }
        .toast.show { transform: translateX(0); }
        .toast-success { border-color: #10B981; }
        .toast-error { border-color: #EF4444; }
        .toast-info { border-color: #3B82F6; }
    </style>
<script src="/js/legacy/managerDashboard-events.js"></script>
<%- include('partials/premium-assets') %>
<link rel="stylesheet" href="/css/finance-dashboard.css"><script defer src="/js/finance-dashboard.js"></script>
    <link rel="stylesheet" href="/css/rolesphere-redesign.css?v=directory-fix-2">
</head>
<body class="rs-dashboard rs-finance-dashboard rs-dot-dashboard bg-gray-50 h-screen flex overflow-hidden">
<%- include('partials/finance-mobile') %>
    <!-- Toast Container -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Sidebar -->
    <aside id="rs-role-sidebar" class="w-64 bg-white border-r border-gray-200 flex flex-col hidden md:flex">
        <div class="rs-sidebar-brand"><%- include('partials/brand') %></div>

        <nav class="flex-1 overflow-y-auto py-4">
        <!-- ══ ANNOUNCEMENT BELL — pinned top of sidebar ══════════════════ -->
        <!-- IMPORTANT: This sits OUTSIDE <nav> so it never scrolls away     -->
        <div class="relative border-b border-gray-100">
            <button
                id="ann-toggle-btn"
                data-rs-click="managerDashboard-0"
                class="w-full flex items-center justify-between px-4 py-3 hover:bg-blue-50 transition-all group"
                title="Announcements"
            >
                <div class="flex items-center gap-3">
                    <!-- Megaphone icon -->
                    <div class="relative">
                        <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                        </svg>
                        <!-- Unread badge — hidden when count is 0 -->
                        <span
                            id="ann-badge"
                            class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center px-1 hidden"
                        >0</span>
                    </div>
                    <span class="text-sm font-semibold text-gray-700 group-hover:text-primary-600">Announcements</span>
                </div>
                <!-- Chevron that rotates when panel opens -->
                <svg id="ann-chevron" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>

            <!-- ── Drop-down panel ────────────────────────────────────────── -->
            <div
                id="ann-panel"
                class="hidden bg-blue-50 border-t border-blue-100 max-h-72 overflow-y-auto"
            >
                <!-- Header row inside panel -->
                <div class="flex items-center justify-between px-4 py-2 border-b border-blue-100">
                    <span class="text-xs font-semibold text-blue-700 uppercase tracking-wider">Latest Announcements</span>
                    <button data-rs-click="managerDashboard-1" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Mark all read</button>
                </div>
                <!-- List of announcements -->
                <div id="ann-list" class="divide-y divide-blue-100">
                    <p class="text-xs text-gray-400 px-4 py-3">Loading…</p>
                </div>
            </div>
        </div>
        <!-- ══ END ANNOUNCEMENT BELL ════════════════════════════════════════ -->

            <div class="px-4 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Overview</div>
            <a href="#" data-rs-click="managerDashboard-2" id="nav-dashboard" class="sidebar-link active flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                Dashboard
            </a>

            <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Management</div>
            <a href="#" data-rs-click="managerDashboard-3" id="nav-team" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path></svg>
                My Team
            </a>

            <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Tasks</div>
            <a href="#" data-rs-click="managerDashboard-4" id="nav-assignTask" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                Assign Task
            </a>
            <a href="#" data-rs-click="managerDashboard-5" id="nav-reviewTasks" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                Review Submissions
            </a>
            <a href="#" data-rs-click="managerDashboard-6" id="nav-allTasks" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                All Assigned Tasks
            </a>
            <a href="#" data-rs-click="managerDashboard-7" id="nav-hrTasks" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Tasks from HR
            </a>

            <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Approvals</div>
            <a href="#" data-rs-click="managerDashboard-8" id="nav-leaveApprovals" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a2 2 0 012-2h4a2 2 0 012 2v4m-6 4v10a2 2 0 002 2h4a2 2 0 002-2V11M9 11h6"></path></svg>
                Leave Requests
            </a>
            <a href="#" data-rs-click="managerDashboard-9" id="nav-reportReviews" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Daily Progress Reports
            </a>
            <a href="#" data-rs-click="managerDashboard-10" id="nav-attendance" class="sidebar-link flex
            items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
            My Attendance
        </a>
        <a href="#" data-rs-click="managerDashboard-11" id="nav-team-attendance" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Employee Attendance
        </a>
       <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Management</div>
            <a href="#" data-rs-click="managerDashboard-12" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7l4-4m0 0l4 4m-4-4v18M16 17l4 4m0 0l-4 4m4-4H3"></path></svg>
                Transfer Requests
            </a>
            <a href="#" data-rs-click="managerDashboard-13" class="sidebar-link flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                Performance Reviews
            </a>
        </nav>

        <div class="p-4 border-t border-gray-100">
            <a href="/manager/logout" class="flex items-center gap-3 px-4 py-3 bg-red-50 text-red-600 rounded-xl hover:bg-red-100 transition-all font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Logout
            </a>
        </div>
    <a class="rs-workbench-nav" href="/workbench">Profile, calendar & teams <span aria-hidden="true">↗</span></a><div class="finance-sidebar-footer"><span class="finance-sidebar-status"></span><span>Connected workspace<small>Your people. Your sphere.</small></span></div></aside>

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebarBackdrop" data-rs-click="managerDashboard-14" class="fixed inset-0 bg-gray-800 bg-opacity-50 z-40 hidden md:hidden"></div>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <div id="rs-dashboard-dots" aria-hidden="true"></div>

        <!-- Top Header -->
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6 z-30">
            <div class="flex items-center gap-4">
                <button data-rs-click="managerDashboard-15" class="md:hidden text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h2 id="pageTitle" class="text-xl font-bold text-gray-800">Dashboard Overview</h2>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right hidden sm:block">
                    <div class="text-sm font-bold text-gray-800"><%= manager.name %></div>
                    <div class="text-xs text-gray-500">Manager</div>
                </div>
                <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-600 font-bold border-2 border-white shadow-sm">
                    <%= manager.name ? manager.name.charAt(0) : 'M' %>
                </div>
            </div>
        </header>

        <!-- Content Scroll Area -->
        <div class="flex-1 overflow-y-auto p-6">

            <!-- Dashboard Section -->
            <section id="dashboardSection" class="space-y-6">
                <%
                    let totalTasks = 0;
                    let completedTasks = 0;
                    let pendingTasks = 0;
                    let pendingReviews = 0;

                    if (employees) {
                        employees.forEach(emp => {
                            if (emp.tasks) {
                                emp.tasks.forEach(task => {
                                    totalTasks++;
                                    if (task.status === 'Completed' || task.status === 'Approved') completedTasks++;
                                    else pendingTasks++;

                                    if (task.status === 'Submitted') pendingReviews++;
                                });
                            }
                        });
                    }
                %>

                <!-- Stats Grid -->
                <div class="finance-welcome"><div><p class="finance-eyebrow">MANAGER WORKSPACE</p><h1>Welcome back, <%= manager.name %><span>.</span></h1><p>Here’s what’s happening in your sphere today.</p></div><time><%= new Intl.DateTimeFormat('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'Asia/Kolkata'}).format(new Date()) %></time></div><div class="grid grid-cols-1 md:grid-cols-4 gap-6 finance-kpis">
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 transform hover:scale-105 transition-transform duration-200">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-gray-500 text-sm font-medium">Total Employees</h3>
                            <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            </div>
                        </div>
                        <div class="text-3xl font-bold text-gray-900"><%= employees ? employees.length : 0 %></div>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 transform hover:scale-105 transition-transform duration-200">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-gray-500 text-sm font-medium">Total Tasks Assigned</h3>
                            <div class="p-2 bg-purple-50 text-purple-600 rounded-lg">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                            </div>
                        </div>
                        <div class="text-3xl font-bold text-gray-900"><%= totalTasks %></div>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 transform hover:scale-105 transition-transform duration-200">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-gray-500 text-sm font-medium">Task Completion Rate</h3>
                            <div class="p-2 bg-green-50 text-green-600 rounded-lg">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        </div>
                        <div class="text-3xl font-bold text-gray-900">
                            <%= totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0 %>%
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 transform hover:scale-105 transition-transform duration-200">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-gray-500 text-sm font-medium">Pending Reviews</h3>
                            <div class="p-2 bg-yellow-50 text-yellow-600 rounded-lg">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        </div>
                        <div class="text-3xl font-bold text-gray-900"><%= pendingReviews %></div>
                    </div>
                </div>

                <!-- Quick Actions & Export -->
                <div class="flex flex-wrap gap-4">
                    <button data-rs-click="managerDashboard-16" class="flex items-center gap-2 px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                        Assign New Task
                    </button>
                    <button data-rs-click="managerDashboard-17" class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Export Data (CSV)
                    </button>
                </div>

                <!-- Charts Row -->
                <%- include('partials/finance-pulse') %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800 mb-4">Employee Task Status</h3>
                        <div class="h-64">
                            <canvas id="taskDistributionChart"></canvas>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                         <h3 class="text-lg font-bold text-gray-800 mb-4">Employee Workload</h3>
                        <div class="h-64">
                            <canvas id="employeeWorkloadChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Team Section -->
            <section id="teamSection" class="hidden space-y-6">
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-4">
                        <h3 class="text-lg font-bold text-gray-900">My Team</h3>
                        <div class="flex items-center gap-3 w-full sm:w-auto">
                            <div class="relative w-full sm:w-64">
                                <input type="text" id="employeeSearch" data-rs-keyup="managerDashboard-18" placeholder="Search employees..." class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm">
                                <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </div>
