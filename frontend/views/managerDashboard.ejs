                <button data-rs-click="managerDashboard-59" class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium transition">Cancel</button>
                <button data-rs-click="managerDashboard-60" class="flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-bold transition">Confirm Removal</button>
