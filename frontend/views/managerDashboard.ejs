                <label class="block text-sm font-medium text-gray-700 mb-2">Reason for Removal <span class="text-red-500">*</span></label>
                <textarea id="removalReasonInput" rows="4" placeholder="Provide a clear reason. This will be visible to the employee and HR." class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-red-400 focus:border-red-400 text-sm resize-none"></textarea>
