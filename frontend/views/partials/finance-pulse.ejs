<section class="finance-pulse" data-finance-pulse aria-label="Workspace activity">
  <article class="finance-card finance-activity"><div class="finance-card-heading"><div><p class="finance-eyebrow">WORKSPACE PULSE</p><h3>Attendance overview</h3><p class="finance-card-subtitle" data-attendance-scope>Last seven days</p></div><button type="button" class="finance-refresh" data-pulse-refresh aria-label="Refresh activity" data-rs-no-hover>↗</button></div>
    <div class="finance-activity-total"><strong data-pulse-present>—</strong><span>present records <small>last 7 days</small></span><span class="finance-legend"><i></i> On time <i></i> Late</span></div>
    <div class="finance-bars" data-pulse-bars aria-live="polite"><p class="finance-loading">Loading your activity…</p></div>
    <p class="finance-load-status" data-pulse-status role="status"></p>
  </article>
  <article class="finance-card finance-completion"><div class="finance-card-heading"><div><p class="finance-eyebrow" data-task-scope>YOUR WORKSPACE</p><h3>Task completion</h3><p class="finance-card-subtitle">Approved tasks out of all assigned tasks</p></div></div>
    <div class="finance-gauge"><svg viewBox="0 0 240 130" aria-hidden="true"><path d="M24 112 A96 96 0 0 1 216 112" pathLength="100" class="finance-gauge-track"/><path d="M24 112 A96 96 0 0 1 216 112" pathLength="100" class="finance-gauge-value" data-pulse-arc stroke-dasharray="0 100"/></svg><strong data-pulse-rate>—</strong></div>
    <div class="finance-task-summary"><p><span>Assigned</span><strong data-pulse-total>—</strong></p><p><span>Approved</span><strong data-pulse-approved>—</strong></p><p><span>Pending</span><strong data-pulse-pending>—</strong></p></div>
    <p class="finance-card-note" data-pulse-note>Your current task progress, in one view.</p>
  </article>
</section>
