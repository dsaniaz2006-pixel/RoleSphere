    <script>


        // --- Task Modal Logic ---
        function openTaskModal(title, desc, deadline, status, feedback) {
            document.getElementById('modalTaskTitle').innerText = title;
            document.getElementById('modalTaskDesc').innerText = desc;
            document.getElementById('modalTaskDeadline').innerText = new Date(deadline).toLocaleDateString();

            const statusEl = document.getElementById('modalTaskStatus');
            statusEl.innerText = status;

            // Reset classes
            statusEl.className = 'inline-flex px-2 py-1 rounded-full text-xs font-bold';
            if (status === 'Completed' || status === 'Approved') statusEl.classList.add('bg-green-100', 'text-green-800');
            else if (status === 'Pending') statusEl.classList.add('bg-yellow-100', 'text-yellow-800');
            else if (status === 'Submitted') statusEl.classList.add('bg-blue-100', 'text-blue-800');
            else if (status === 'Rejected') statusEl.classList.add('bg-red-100', 'text-red-800');
            else statusEl.classList.add('bg-gray-100', 'text-gray-800');

            const feedbackSection = document.getElementById('modalFeedbackSection');
            if(feedback && feedback !== 'undefined' && feedback !== '') {
                document.getElementById('modalTaskFeedback').innerText = feedback;
                feedbackSection.classList.remove('hidden');
            } else {
                feedbackSection.classList.add('hidden');
            }

            document.getElementById('taskModal').classList.remove('hidden');
        }

        function closeTaskModal() {
            document.getElementById('taskModal').classList.add('hidden');
        }

        const currentEmployee = {
            id: <%- jsonForScript(employee._id) %>,
        };
        let loadedTasks = [];
        let taskChart = null;

        // Toast Notification
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;

            let icon = '';
            if (type === 'success') icon = '<svg class="w-6 h-6 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            else if (type === 'error') icon = '<svg class="w-6 h-6 text-red-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
            else icon = '<svg class="w-6 h-6 text-blue-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';

            toast.innerHTML = `${icon}<span class="text-gray-800 font-medium">${message}</span>`;

            container.appendChild(toast);

            // Animate in
            requestAnimationFrame(() => {
                toast.classList.add('show');
            });

            // Remove after 3s
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Update Chart
        function updateTaskChart(tasks) {
            const ctx = document.getElementById('employeeTaskChart').getContext('2d');

            let statusCounts = { 'Completed': 0, 'In Progress': 0, 'Pending': 0, 'Submitted': 0, 'Rejected': 0 };

            if(tasks) {
                tasks.forEach(task => {
                    let status = task.status;
                    if (status === 'Approved') status = 'Completed';

                    if (statusCounts.hasOwnProperty(status)) statusCounts[status]++;
                    else statusCounts['Pending']++;
                });
            }

            if (taskChart) {
                taskChart.destroy();
            }

            taskChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(statusCounts),
                    datasets: [{
                        data: Object.values(statusCounts),
                        backgroundColor: [
                            '#10B981', // Completed (Green)
                            '#3B82F6', // In Progress (Blue)
                            '#F59E0B', // Pending (Yellow)
                            '#8B5CF6', // Submitted (Purple)
                            '#EF4444'  // Rejected (Red)
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        // Initialize
        window.onload = function() {
            currentEmployee.name = <%- jsonForScript(employee.name) %>;
            currentEmployee.email = <%- jsonForScript(employee.email) %>;

            // Set UI elements
            document.getElementById("welcomeName").innerText = currentEmployee.name;
            document.getElementById("profileName").innerText = currentEmployee.name;
            document.getElementById("profileEmail").innerText = currentEmployee.email;

            // Pre-fill edit form
            document.getElementById("editName").value = currentEmployee.name;
            document.getElementById("editEmail").value = currentEmployee.email;

            // Load Initial Data
            loadAssignedTasks();
            loadReportHistory();
            loadLeaveHistory();
            loadLeaveBalance();
            loadManagerInfo();
            loadAnnouncements();

            // Show default section
            showSection('welcomeSection');

            // Setup Listeners
            document.getElementById('workReportForm').addEventListener('submit', submitWorkReport);
            document.getElementById('leaveForm').addEventListener('submit', submitLeaveForm);
            document.getElementById('uploadTaskForm').addEventListener('submit', submitTaskUpload);
        };

        // Navigation Logic
        function showSection(sectionId) {
            // Hide all sections
            document.querySelectorAll('.section-content').forEach(el => el.classList.add('hidden'));
            // Show target section
            document.getElementById(sectionId).classList.remove('hidden');

            // Update active state in sidebar
            document.querySelectorAll('.nav-item').forEach(el => {
                if(el.getAttribute('onclick').includes(sectionId)) {
                    el.classList.add('bg-gray-50', 'text-primary-600');
                } else {
                    el.classList.remove('bg-gray-50', 'text-primary-600');
                }
            });
        }

        // Profile Functions
        function editProfile() {
            document.getElementById('viewProfile').classList.add('hidden');
            document.getElementById('editProfileForm').classList.remove('hidden');
        }

        function cancelEditProfile() {
            document.getElementById('editProfileForm').classList.add('hidden');
            document.getElementById('viewProfile').classList.remove('hidden');
        }

       async function updateProfile(e) {
    e.preventDefault();

    const updatedData = {
        email: currentEmployee.email,
        name: document.getElementById('editName').value,
        phone: document.getElementById('editPhone').value,
        department: document.getElementById('editDepartment').value,
        address: document.getElementById('editAddress').value
    };

    try {
        const response = await fetch('/employee/updateProfile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(updatedData)
        });

        // 🚨 If route not found or server error
        if (!response.ok) {
            throw new Error(`Server error: ${response.status}`);
        }

        // 🚨 Ensure response is JSON
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            throw new Error('Invalid response from server');
        }

        const result = await response.json();

        if (result.success) {
            // Update local object
            currentEmployee.name = updatedData.name;
            currentEmployee.phone = updatedData.phone;
            currentEmployee.department = updatedData.department;
            currentEmployee.address = updatedData.address;

            // Update UI
            document.getElementById("profileName").innerText = currentEmployee.name;
            document.getElementById("profilePhone").innerText = currentEmployee.phone || '-';
            document.getElementById("profileDepartment").innerText = currentEmployee.department || '-';
            document.getElementById("profileAddress").innerText = currentEmployee.address || '-';
            document.getElementById("welcomeName").innerText = currentEmployee.name;

            showToast('Profile updated successfully!', 'success');
            cancelEditProfile();
        } else {
            showToast(result.error || 'Profile update failed', 'error');
        }

    } catch (error) {
        console.error('Profile update error:', error);
        showToast('Profile update API not found or server error', 'error');
    }
}

document.getElementById('photoUploadForm').addEventListener('submit', async function(e) {
