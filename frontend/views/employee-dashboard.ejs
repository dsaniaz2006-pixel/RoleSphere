<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/premium-head') %>
<script src="/vendor/purify.min.js"></script><script src="/js/ui.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Dashboard - RoleSphere</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/rolesphere-redesign.css">
    <link rel="stylesheet" href="/css/dashboard-background.css">
    <script defer src="/js/dashboard-background.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

    <style>
        /* Toast Notification */
        .toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 50; }
        .toast {
            min-width: 250px;
            background: white;
            border-left: 4px solid;
            padding: 16px;
            margin-bottom: 10px;
            border-radius: 4px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
            display: flex;
            align-items: center;
        }
        .toast.show { transform: translateX(0); }
        .toast-success { border-color: #10B981; }
        .toast-error { border-color: #EF4444; }
        .toast-info { border-color: #3B82F6; }
    </style>
<script src="/js/legacy/employee-dashboard-events.js"></script>
<%- include('partials/premium-assets') %>
<link rel="stylesheet" href="/css/finance-dashboard.css"><script defer src="/js/finance-dashboard.js"></script>
</head>
<body class="rs-dashboard rs-finance-dashboard rs-dot-dashboard bg-gray-50 font-sans antialiased h-screen flex overflow-hidden">
<%- include('partials/finance-mobile') %>
    <!-- Toast Container -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Sidebar -->
    <aside id="rs-role-sidebar" class="bg-white w-64 border-r border-gray-200 flex flex-col hidden md:flex">
        <div class="rs-sidebar-brand"><%- include('partials/brand') %></div>

        <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
        <!-- ══ ANNOUNCEMENT BELL — pinned top of sidebar ══════════════════ -->
        <!-- IMPORTANT: This sits OUTSIDE <nav> so it never scrolls away     -->
        <div class="relative border-b border-gray-100">
            <button
                id="ann-toggle-btn"
                data-rs-click="employee-dashboard-0"
                class="w-full flex items-center justify-between px-4 py-3 hover:bg-blue-50 transition-all group"
                title="Announcements"
            >
                <div class="flex items-center gap-3">
                    <!-- Megaphone icon -->
                    <div class="relative">
                        <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                        </svg>
                        <!-- Unread badge — hidden when count is 0 -->
                        <span
                            id="ann-badge"
                            class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center px-1 hidden"
                        >0</span>
                    </div>
                    <span class="text-sm font-semibold text-gray-700 group-hover:text-primary-600">Announcements</span>
                </div>
                <!-- Chevron that rotates when panel opens -->
                <svg id="ann-chevron" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>

            <!-- ── Drop-down panel ────────────────────────────────────────── -->
            <div
                id="ann-panel"
                class="hidden bg-blue-50 border-t border-blue-100 max-h-72 overflow-y-auto"
            >
                <!-- Header row inside panel -->
                <div class="flex items-center justify-between px-4 py-2 border-b border-blue-100">
                    <span class="text-xs font-semibold text-blue-700 uppercase tracking-wider">Latest Announcements</span>
                    <button data-rs-click="employee-dashboard-1" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Mark all read</button>
                </div>
                <!-- List of announcements -->
                <div id="ann-list" class="divide-y divide-blue-100">
                    <p class="text-xs text-gray-400 px-4 py-3">Loading…</p>
                </div>
            </div>
        </div>
        <!-- ══ END ANNOUNCEMENT BELL ════════════════════════════════════════ -->

            <button data-rs-click="employee-dashboard-2" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                Dashboard
            </button>
            <button data-rs-click="employee-dashboard-3" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                Profile
            </button>
            <button data-rs-click="employee-dashboard-4" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                Assigned Tasks
            </button>
            <button data-rs-click="employee-dashboard-5" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Daily Progress Reports
            </button>
            <button data-rs-click="employee-dashboard-6" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a2 2 0 012-2h4a2 2 0 012 2v4m-6 4v10a2 2 0 002 2h4a2 2 0 002-2V11M9 11h6"></path></svg>
                Apply Leave
            </button>
            <button data-rs-click="employee-dashboard-7" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                Attendance
            </button>
            <button data-rs-click="employee-dashboard-8" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7l4-4m0 0l4 4m-4-4v18M16 17l4 4m0 0l-4 4m4-4H3"></path></svg>
                Request Transfer
            </button>
            <button data-rs-click="employee-dashboard-9" class="nav-item w-full flex items-center px-3 py-2 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors group">
                <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                My Reviews
            </button>

        </nav>

        <div class="p-4 border-t border-gray-200">
            <a href="/employee/logout" class="flex items-center px-3 py-2 text-sm font-medium text-red-600 rounded-lg hover:bg-red-50 transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Logout
            </a>
        </div>
    <a class="rs-workbench-nav" href="/workbench">Profile, calendar & teams <span aria-hidden="true">↗</span></a><div class="finance-sidebar-footer"><span class="finance-sidebar-status"></span><span>Connected workspace<small>Your people. Your sphere.</small></span></div></aside>

    <!-- Mobile Header -->
    <div class="md:hidden fixed top-0 left-0 right-0 bg-white border-b border-gray-200 z-50 px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
             <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center text-white font-bold text-lg">R</div>
             <span class="font-bold text-lg text-gray-900">Employee</span>
        </div>
        <button data-rs-click="employee-dashboard-10" class="text-gray-500 hover:text-gray-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
    </div>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto bg-gray-50 p-4 md:p-8 mt-16 md:mt-0">
        <div id="rs-dashboard-dots" aria-hidden="true"></div>
        <div class="max-w-6xl mx-auto">

            <!-- Transfer Request Section -->
            <div id="transferSection" class="section-content hidden">
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 max-w-2xl">
                <h2 class="text-xl font-bold text-gray-900 mb-1">Request Manager Transfer</h2>
                <p class="text-sm text-gray-500 mb-6">Submit a request to be moved to a different manager's team. Your current manager will review it first, then HR will assign you.</p>

                <!-- Status card — shown if request already exists -->
                <div id="transferStatusCard" class="hidden bg-blue-50 border border-blue-200 rounded-xl p-5 mb-5">
                  <p class="text-sm font-bold text-blue-800 mb-3">📋 Your Transfer Request</p>
                  <div class="space-y-2 text-sm text-blue-700">
                    <p>Reason submitted: <span id="transferReasonDisplay" class="italic text-gray-700"></span></p>
                    <p>Manager decision: <span id="transferManagerStatus" class="font-bold"></span></p>
                    <p id="transferManagerNoteRow" class="hidden text-xs text-gray-600">Manager note: <span id="transferManagerNote"></span></p>
                    <p>HR status: <span id="transferHRStatus" class="font-bold"></span></p>
                    <p id="transferNewManagerRow" class="hidden text-xs text-green-700 font-semibold">✅ New Manager: <span id="transferNewManager"></span></p>
                  </div>
                </div>

                <!-- Form — hidden if pending request exists -->
                <div id="transferFormWrapper">
                  <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Why do you want to transfer? <span class="text-red-500">*</span></label>
                    <textarea id="transferReasonInput" rows="4"
                      placeholder="Describe your reason clearly (min 10 characters)..."
                      class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-400 resize-none"></textarea>
                  </div>
                  <div class="flex gap-3">
                    <button data-rs-click="employee-dashboard-11"
                      class="px-5 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition">
                      Submit Request
                    </button>
                  </div>
                  <p id="transferFormMsg" class="text-xs mt-2 hidden"></p>
                </div>
              </div>
            </div>

            <!-- Removal Notice Banner (hidden by default, shown via JS) -->
            <div id="removalNoticeBanner" class="hidden mb-6">
                <div class="bg-red-50 border border-red-200 rounded-xl p-6">
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-base font-bold text-red-800 mb-1">You have been removed from your team</h3>
                            <p class="text-sm text-red-600 mb-1">Manager: <span id="removalManagerName" class="font-semibold"></span></p>
                            <p class="text-sm text-red-700 mb-4">Reason: <span id="removalReasonText" class="italic"></span></p>

                            <!-- Accepted State -->
                            <div id="removalAcceptedMsg" class="hidden bg-green-50 border border-green-200 rounded-lg p-3 text-sm text-green-700 font-medium">
                                ✅ You have accepted the removal.
                            </div>

                            <!-- Complaint Submitted State -->
                            <div id="complaintSubmittedMsg" class="hidden bg-blue-50 border border-blue-200 rounded-lg p-3">
                                <p class="text-sm text-blue-700 font-medium">📨 Your complaint has been submitted to HR.</p>
                                <p class="text-xs text-blue-500 mt-1">Status: <span id="complaintStatusText" class="font-semibold"></span></p>
                                <p id="hrNoteSection" class="hidden text-xs text-gray-600 mt-2">HR Note: <span id="hrNoteText" class="italic"></span></p>
                            </div>

                            <!-- Action Buttons (shown if no action taken yet) -->
                            <div id="removalActionButtons" class="flex flex-col sm:flex-row gap-3">
                                <button data-rs-click="employee-dashboard-12" class="flex items-center justify-center gap-2 px-5 py-2.5 bg-gray-600 text-white text-sm font-semibold rounded-lg hover:bg-gray-700 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                    Accept Removal
                                </button>
                                <button data-rs-click="employee-dashboard-13" class="flex items-center justify-center gap-2 px-5 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                    File Complaint to HR
                                </button>
                            </div>

                            <!-- Complaint Form (hidden until button clicked) -->
                            <div id="complaintFormContainer" class="hidden mt-4 bg-white border border-red-100 rounded-xl p-5">
                                <h4 class="text-sm font-bold text-gray-800 mb-3">File a Complaint to HR</h4>
                                <form id="complaintForm" enctype="multipart/form-data">
                                    <div class="mb-4">
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Your Complaint <span class="text-red-500">*</span></label>
                                        <textarea id="complaintTextInput" name="complaintText" rows="4" placeholder="Describe why you disagree with this removal decision..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-400 focus:border-red-400 resize-none"></textarea>
                                    </div>
                                    <div class="mb-4">
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Attach Supporting File (optional)</label>
                                        <%- include('partials/upload-field', { inputId:'complaintAttachment', inputName:'attachment', label:'Add supporting documents', accept:'.jpg,.jpeg,.pdf', required:false, changeHandler:'' }) %><p id="selectedFileName" hidden></p>
                                    </div>
                                    <div class="flex gap-3">
                                        <button type="button" data-rs-click="employee-dashboard-14" class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium transition">Cancel</button>
                                        <button type="button" data-rs-click="employee-dashboard-15" class="flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-bold transition">Submit Complaint</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="welcomeSection" class="section-content"><div class="finance-welcome"><div><p class="finance-eyebrow">EMPLOYEE WORKSPACE</p><h1>Welcome back, <span id="welcomeName"><%= employee.name %></span><span>.</span></h1><p>Here’s what’s happening in your sphere today.</p></div><time><%= new Intl.DateTimeFormat('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'Asia/Kolkata'}).format(new Date()) %></time></div>
<%- include('partials/finance-pulse') %>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <!-- Stats Column -->
                    <div class="lg:col-span-2 space-y-6">
                        <!-- Manager Info Card -->
                        <div id="managerInfoCard" class="hidden bg-white rounded-xl shadow-sm border border-indigo-100 p-5 flex items-center gap-4">
                            <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center flex-shrink-0">
                                <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-wide">Your Manager</p>
                                <p class="text-lg font-bold text-gray-900" id="managerNameDisplay">—</p>
                                <p class="text-xs text-gray-500 mt-0.5">You are part of this manager's team. Tasks will be assigned through your dashboard.</p>
                            </div>
                        </div>
                        <div id="noManagerCard" class="hidden bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                            <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                                <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Manager</p>
                                <p class="text-base font-semibold text-gray-500">Not assigned yet</p>
                                <p class="text-xs text-gray-400 mt-0.5">A manager will be assigned to you shortly.</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 transform hover:scale-105 transition-transform duration-200">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-gray-500 text-sm font-medium">Pending Tasks</h3>
                                    <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded-full">Action Needed</span>
                                </div>
                                <p class="text-3xl font-bold text-gray-900" id="pendingTasksCount">-</p>
                            </div>
                            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 transform hover:scale-105 transition-transform duration-200">
                                 <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-gray-500 text-sm font-medium">Reports Submitted</h3>
                                    <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">This Month</span>
                                </div>
                                <p class="text-3xl font-bold text-gray-900" id="submittedReportsCount">-</p>
                            </div>
                        </div>

                        <!-- New Widgets Row -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                            <!-- Announcements Widget -->
                            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-lg font-bold text-gray-900">Announcements</h3>
                                    <span class="text-xs text-primary-600 font-medium cursor-pointer hover:underline">View All</span>
                                </div>
                                <div class="space-y-4" id="announcementsList">
                                    <p class="text-sm text-gray-400">Loading...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart Column -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-4">Your Task Progress</h3>
                        <div class="h-64 flex items-center justify-center">
                            <canvas id="employeeTaskChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Profile Section -->
            <div id="profileSection" class="section-content hidden">
