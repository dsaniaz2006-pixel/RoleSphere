        // ── Attendance System ── //
        const EMPLOYEE_ID = <%- jsonForScript(typeof employee !== "undefined" && employee._id ? employee._id : "") %>;
        let attInterval = null;
        let checkInTimestamp = null;

        const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

        function formatDuration(checkInStr, checkOutStr) {
            if (!checkInStr || checkInStr === '-' || !checkOutStr || checkOutStr === '-') return '--:--:--';
            const toSecs = t => { const [h,m,s] = t.split(':').map(Number); return h*3600+m*60+s; };
            let diff = toSecs(checkOutStr) - toSecs(checkInStr);
            if (diff < 0) diff += 86400;
            const h = Math.floor(diff/3600).toString().padStart(2,'0');
            const m = Math.floor((diff%3600)/60).toString().padStart(2,'0');
            const s = (diff%60).toString().padStart(2,'0');
            return `${h}:${m}:${s}`;
        }

        function startLiveTimer(checkInStr) {
            const timerEl = document.getElementById('attTimerDisplay');
            const liveEl = document.getElementById('attLiveTimer');
            liveEl.classList.remove('hidden');
            if (attInterval) clearInterval(attInterval);
            const toSecs = t => { const [h,m,s] = t.split(':').map(Number); return h*3600+m*60+s; };
            const startSecs = toSecs(checkInStr);
            attInterval = setInterval(() => {
                const now = new Date();
                const nowSecs = now.getHours()*3600 + now.getMinutes()*60 + now.getSeconds();
                let diff = nowSecs - startSecs;
                if (diff < 0) diff = 0;
                const h = Math.floor(diff/3600).toString().padStart(2,'0');
                const m = Math.floor((diff%3600)/60).toString().padStart(2,'0');
                const s = (diff%60).toString().padStart(2,'0');
                timerEl.innerText = `${h}:${m}:${s}`;
            }, 1000);
        }

        async function loadTodayStatus() {
            if (!EMPLOYEE_ID) return;
            const today = new Date().toISOString().split('T')[0];
            const day = DAYS[new Date().getDay()];
            document.getElementById('attTodayDate').innerText = `${today} (${day})`;

            if (new Date().getDay() === 0) {
                document.getElementById('attSundayMsg').classList.remove('hidden');
                document.getElementById('checkInBtn').disabled = true;
                document.getElementById('checkInBtn').classList.add('opacity-50', 'cursor-not-allowed');
                return;
            }

            try {
                const res = await fetch(`/api/attendance/today-status?userId=${EMPLOYEE_ID}`);
                const data = await res.json();
                const rec = data.record;
                if (!rec) return;

                document.getElementById('attCheckInTime').innerText = rec.checkIn || '--:--:--';
                document.getElementById('attCheckOutTime').innerText = rec.checkOut || '--:--:--';
                document.getElementById('attDuration').innerText = formatDuration(rec.checkIn, rec.checkOut);

                if (rec.checkIn && !rec.checkOut) {
                    if (rec.isLate) {
                        document.getElementById('attTodayStatus').innerText = 'Checked In — Late';
                        document.getElementById('attTodayStatus').className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-orange-100 text-orange-700';
                    } else {
                        document.getElementById('attTodayStatus').innerText = 'Checked In';
                        document.getElementById('attTodayStatus').className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-700';
                    }
                    document.getElementById('checkInBtn').classList.add('hidden');
                    document.getElementById('checkOutBtn').classList.remove('hidden');
                    startLiveTimer(rec.checkIn);
                } else if (rec.checkIn && rec.checkOut) {
                    document.getElementById('attTodayStatus').innerText = 'Checked Out';
                    document.getElementById('attTodayStatus').className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-700';
                    document.getElementById('checkInBtn').classList.add('hidden');
                    document.getElementById('checkOutBtn').classList.add('hidden');
                    document.getElementById('attLiveTimer').classList.add('hidden');
                }
            } catch (e) { console.error('Failed to load today status', e); }
        }

        async function doCheckIn() {
            if (!EMPLOYEE_ID) return alert('Session expired. Please login again.');
            try {
                const res = await fetch('/api/attendance/checkin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: EMPLOYEE_ID, userModel: 'Employee' })
                });
                const data = await res.json();
                if (!data.success) return alert(data.error || 'Check-in failed');
                document.getElementById('attCheckInTime').innerText = data.record.checkIn;

                // Show "Late" badge if checked in after shift start (09:15)
                if (data.isLate) {
                    document.getElementById('attTodayStatus').innerText = 'Checked In — Late';
                    document.getElementById('attTodayStatus').className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-orange-100 text-orange-700';
                    showToast('You checked in late (after 09:15 AM). This has been recorded.', 'error');
                } else {
                    document.getElementById('attTodayStatus').innerText = 'Checked In';
                    document.getElementById('attTodayStatus').className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-700';
                }
                document.getElementById('checkInBtn').classList.add('hidden');
                document.getElementById('checkOutBtn').classList.remove('hidden');
                startLiveTimer(data.record.checkIn);
            } catch (e) { alert('Check-in failed'); }
        }

        async function doCheckOut() {
            if (!EMPLOYEE_ID) return;
            try {
                const res = await fetch('/api/attendance/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: EMPLOYEE_ID })
                });
                const data = await res.json();
                if (!data.success) return alert(data.error || 'Check-out failed');
                clearInterval(attInterval);
                document.getElementById('attLiveTimer').classList.add('hidden');
                document.getElementById('attCheckOutTime').innerText = data.record.checkOut;
                document.getElementById('attDuration').innerText = formatDuration(data.record.checkIn, data.record.checkOut);
                document.getElementById('attTodayStatus').innerText = 'Checked Out';
                document.getElementById('attTodayStatus').className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-700';
                document.getElementById('checkOutBtn').classList.add('hidden');
            } catch (e) { alert('Check-out failed'); }
        }

        async function loadMyHistory() {
            const monthVal = document.getElementById('attMonthPicker').value;
            if (!monthVal || !EMPLOYEE_ID) return;
            try {
                const res = await fetch(`/api/attendance/my-history?userId=${EMPLOYEE_ID}&month=${monthVal}`);
                const data = await res.json();
                renderHistoryTable(data.records, monthVal);
            } catch (e) { console.error(e); }
        }

        function renderHistoryTable(records, monthStr) {
            const tbody = document.getElementById('attHistoryBody');
            const [year, mon] = monthStr.split('-').map(Number);
            const daysInMonth = new Date(year, mon, 0).getDate();
            let html = '';
            for (let d = 1; d <= daysInMonth; d++) {
                const dateStr = `${year}-${String(mon).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
                const dayOfWeek = new Date(dateStr).getDay();
                const dayName = DAYS[dayOfWeek];
                const isSun = dayOfWeek === 0;
                const rec = records.find(r => r.date === dateStr);

                let statusBadge, rowClass = '';
                if (isSun) {
                    statusBadge = '<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">Holiday</span>';
                    rowClass = 'bg-purple-50';
                } else if (rec && rec.checkIn) {
                    statusBadge = '<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Present</span>';
                } else {
                    statusBadge = '<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">Absent</span>';
                    rowClass = 'bg-red-50';
                }

                const lateBadge = (!isSun && rec?.isLate)
                    ? '<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-700">Late</span>'
                    : ((!isSun && rec?.checkIn) ? '<span class="text-xs text-gray-400">On time</span>' : '-');

                html += `<tr class="${rowClass} hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-3 text-sm text-gray-700">${dateStr}</td>
                    <td class="px-6 py-3 text-sm font-medium ${isSun ? 'text-purple-600' : 'text-gray-700'}">${dayName}</td>
                    <td class="px-6 py-3">${statusBadge}</td>
                    <td class="px-6 py-3">${lateBadge}</td>
                    <td class="px-6 py-3 text-sm font-mono ${rec?.checkIn ? 'text-green-600 font-semibold' : 'text-gray-400'}">${rec?.checkIn || '-'}</td>
                    <td class="px-6 py-3 text-sm font-mono ${rec?.checkOut ? 'text-red-500 font-semibold' : 'text-gray-400'}">${rec?.checkOut || '-'}</td>
                    <td class="px-6 py-3 text-sm font-mono text-blue-600">${formatDuration(rec?.checkIn, rec?.checkOut)}</td>
                </tr>`;
            }
            tbody.innerHTML = html;
        }

        // Set default month picker to current month and load today status
        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            const m = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
            document.getElementById('attMonthPicker').value = m;
            loadTodayStatus();
        });


        // ── Manager Info ──────────────────────────────────────────────────
        async function loadManagerInfo() {
            try {
                const res  = await fetch('/employee/getManagerInfo');
                const data = await res.json();

                if (data.success && data.managerName) {
                    document.getElementById('managerNameDisplay').innerText = data.managerName;
                    document.getElementById('managerInfoCard').classList.remove('hidden');
                    document.getElementById('noManagerCard').classList.add('hidden');
                } else {
                    document.getElementById('noManagerCard').classList.remove('hidden');
                    document.getElementById('managerInfoCard').classList.add('hidden');
                }
            } catch (err) {
                console.error('Failed to load manager info:', err);
                document.getElementById('noManagerCard').classList.remove('hidden');
            }
        }

        async function loadAnnouncements() {
            try {
                const res  = await fetch('/api/overview/announcements');
                const data = await res.json();
                const container = document.getElementById('announcementsList');
                if (!container) return;
                if (!data.success || !data.announcements || data.announcements.length === 0) {
                    container.innerHTML = '<p class="text-sm text-gray-400">No announcements yet.</p>';
                    return;
                }
                const colors = ['border-primary-500','border-yellow-500','border-green-500','border-indigo-500'];
                container.innerHTML = data.announcements.slice(0,4).map(function(a, i) {
                    return '<div class="border-l-4 ' + colors[i % colors.length] + ' pl-3 py-1">' +
                        '<p class="text-sm font-medium text-gray-900">' + a.title + '</p>' +
                        '<p class="text-xs text-gray-500 mt-0.5">' + a.message.substring(0,80) + (a.message.length > 80 ? '...' : '') + '</p>' +
                        '</div>';
                    }).join('');
                } catch(err) {
                    console.error('Announcements load error:', err);
                }
            }

        // ── Removal Notice ────────────────────────────────────────────────
        async function checkRemovalStatus() {
            try {
                const res  = await fetch('/api/complaints/my-status');
                const data = await res.json();
                if (!data.success || !data.hasRemovalNotice) return;

                // Show the banner
                document.getElementById('removalNoticeBanner').classList.remove('hidden');
                document.getElementById('removalManagerName').textContent = data.managerName;
                document.getElementById('removalReasonText').textContent  = data.removalReason;

                const actionBtns       = document.getElementById('removalActionButtons');
                const acceptedMsg      = document.getElementById('removalAcceptedMsg');
                const complaintMsg     = document.getElementById('complaintSubmittedMsg');

                if (data.removalAccepted) {
                    actionBtns.classList.add('hidden');
                    acceptedMsg.classList.remove('hidden');
                } else if (data.complaint && data.complaint.submitted) {
                    actionBtns.classList.add('hidden');
                    complaintMsg.classList.remove('hidden');
                    document.getElementById('complaintStatusText').textContent = data.complaint.status;
                    if (data.complaint.hrNote) {
                        document.getElementById('hrNoteSection').classList.remove('hidden');
                        document.getElementById('hrNoteText').textContent = data.complaint.hrNote;
                    }
                }
            } catch (err) {
                console.error('Failed to check removal status:', err);
            }
        }

        function showComplaintForm() {
            document.getElementById('complaintFormContainer').classList.remove('hidden');
            document.getElementById('removalActionButtons').classList.add('hidden');
        }

        function hideComplaintForm() {
            document.getElementById('complaintFormContainer').classList.add('hidden');
            document.getElementById('removalActionButtons').classList.remove('hidden');
        }

        // Show file name when selected
        document.addEventListener('DOMContentLoaded', () => {
            const fileInput = document.getElementById('complaintAttachment');
            if (fileInput) {
                fileInput.addEventListener('change', () => {
                    const label = document.getElementById('selectedFileName');
                    if (fileInput.files.length > 0) {
                        label.textContent = '📎 ' + fileInput.files[0].name;
                        label.classList.remove('hidden');
                    } else {
                        label.classList.add('hidden');
                    }
                });
            }
        });

        async function acceptRemoval() {
            if (!confirm('Are you sure you want to accept the removal? This cannot be undone.')) return;
            try {
                const res  = await fetch('/api/complaints/accept-removal', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('removalActionButtons').classList.add('hidden');
                    document.getElementById('removalAcceptedMsg').classList.remove('hidden');
                    showToast('You have accepted the removal.', 'success');
                } else {
                    showToast(data.error || 'Failed to process.', 'error');
                }
            } catch (err) {
                showToast('Server error. Try again.', 'error');
            }
        }

        async function submitComplaint() {
            const text = document.getElementById('complaintTextInput').value.trim();
            if (!text || text.length < 10) {
                showToast('Please write a complaint of at least 10 characters.', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('complaintText', text);
            const fileInput = document.getElementById('complaintAttachment');
            if (fileInput.files.length > 0) {
                formData.append('attachment', fileInput.files[0]);
            }

            const btn = document.querySelector('#complaintForm button[data-rs-click="employee-dashboard-34"]');
            btn.textContent = 'Submitting...';
            btn.disabled = true;

            try {
                const res  = await fetch('/api/complaints/submit', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('complaintFormContainer').classList.add('hidden');
                    document.getElementById('removalActionButtons').classList.add('hidden');
                    const complaintMsg = document.getElementById('complaintSubmittedMsg');
                    complaintMsg.classList.remove('hidden');
                    document.getElementById('complaintStatusText').textContent = 'Pending';
                    showToast('Complaint submitted to HR successfully.', 'success');
                } else {
                    showToast(data.error || 'Failed to submit complaint.', 'error');
                }
            } catch (err) {
                showToast('Server error. Try again.', 'error');
            } finally {
                btn.textContent = 'Submit Complaint';
                btn.disabled = false;
            }
        }

        // Call on page load
        window.addEventListener('load', () => {
            checkRemovalStatus();
        });

        // ── Transfer Request ──────────────────────────────────────────────
        async function loadTransferStatus() {
            try {
                const res  = await fetch('/api/transfer/my-status');
                const data = await res.json();
                if (!data.success) return;

                if (data.hasRequest) {
                    const t = data.transfer;
                    document.getElementById('transferStatusCard').classList.remove('hidden');
                    document.getElementById('transferReasonDisplay').textContent = t.reason;
                    document.getElementById('transferManagerStatus').textContent = t.managerStatus;
                    document.getElementById('transferHRStatus').textContent      = t.hrStatus === 'Pending' ? 'Awaiting HR' : t.hrStatus;

                    const statusColors = { Pending: 'text-yellow-600', Approved: 'text-green-600', Rejected: 'text-red-600', Assigned: 'text-green-700' };
                    document.getElementById('transferManagerStatus').className = 'font-bold ' + (statusColors[t.managerStatus] || '');
                    document.getElementById('transferHRStatus').className      = 'font-bold ' + (statusColors[t.hrStatus]      || '');

                    if (t.managerNote) {
                        document.getElementById('transferManagerNoteRow').classList.remove('hidden');
                        document.getElementById('transferManagerNote').textContent = t.managerNote;
                    }
                    if (t.newManagerName) {
                        document.getElementById('transferNewManagerRow').classList.remove('hidden');
                        document.getElementById('transferNewManager').textContent = t.newManagerName;
                    }
                    // Hide form if still pending manager review
                    if (t.managerStatus === 'Pending') {
                        document.getElementById('transferFormWrapper').classList.add('hidden');
                    }
                }
            } catch (err) {
                console.error('Transfer status load error:', err);
            }
        }

        async function submitTransferRequest() {
            const reason = document.getElementById('transferReasonInput').value.trim();
            const msg    = document.getElementById('transferFormMsg');
            msg.className = 'text-xs mt-2';
            msg.classList.remove('hidden');

            if (reason.length < 10) {
                msg.textContent = 'Please provide at least 10 characters.';
                msg.classList.add('text-red-600');
                return;
            }

            try {
                const res  = await fetch('/api/transfer/request', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ reason })
                });
                const data = await res.json();
                if (data.success) {
                    msg.textContent = '\u2705 Request submitted. Your manager will review it.';
                    msg.classList.add('text-green-600');
                    document.getElementById('transferFormWrapper').classList.add('hidden');
                    setTimeout(() => loadTransferStatus(), 800);
                } else {
                    msg.textContent = data.error || 'Failed to submit.';
                    msg.classList.add('text-red-600');
                }
            } catch (err) {
                msg.textContent = 'Network error. Try again.';
                msg.classList.add('text-red-600');
            }
        }

        // Call on page load
        window.addEventListener('load', () => {
            loadTransferStatus();
        });

        // ── My Performance Reviews (Employee) ──────────────────────────────
        async function loadMyPerformanceReviews() {
            var countEl  = document.getElementById('emp-perf-count');
            var avgEl    = document.getElementById('emp-perf-avg');
            var latestEl = document.getElementById('emp-perf-latest');
            var listEl   = document.getElementById('emp-reviews-list');
            if (!listEl) return;
            listEl.innerHTML = '<p class="text-sm text-gray-400">Loading...</p>';
            try {
                var res  = await fetch('/api/performance/my-reviews');
                var data = await res.json();
                if (!data.success || !data.reviews || !data.reviews.length) {
                    listEl.innerHTML = '<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 text-center"><p class="text-3xl mb-2">&#128203;</p><p class="text-sm text-gray-500 font-medium">No performance reviews yet.</p><p class="text-xs text-gray-400 mt-1">Your manager will submit reviews here after each review period.</p></div>';
                    if(countEl) countEl.textContent='0';
                    if(avgEl)   avgEl.textContent='-';
                    if(latestEl)latestEl.textContent='-';
                    return;
                }
                var reviews = data.reviews;
                if(countEl) countEl.textContent = reviews.length;
                var avg = (reviews.reduce(function(s,r){return s+r.rating;},0)/reviews.length).toFixed(1);
                if(avgEl)    avgEl.textContent = avg+'&#9733;';
                if(latestEl) latestEl.textContent = reviews[0].rating+'&#9733;';

                var ratingColors = {1:'text-red-500',2:'text-orange-500',3:'text-amber-500',4:'text-blue-600',5:'text-green-600'};
                var ratingLabels2 = {1:'Poor',2:'Below Average',3:'Average',4:'Good',5:'Excellent'};
                listEl.innerHTML = reviews.map(function(r) {
                    var stars = '&#9733;'.repeat(r.rating)+'&#9734;'.repeat(5-r.rating);
                    var goals = r.goals && r.goals.length ? r.goals.map(function(g){
                        var dot = g.status==='Achieved'?'bg-green-500':g.status==='In Progress'?'bg-blue-500':'bg-gray-300';
                        return '<span class="flex items-center gap-1.5 text-xs text-gray-600"><span class="w-2 h-2 rounded-full '+dot+' inline-block"></span>'+g.description+'</span>';
                    }).join('') : '';
                    return '<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">'+
                        '<div class="flex items-start justify-between mb-4">'+
                            '<div>'+
                                '<p class="text-sm font-bold text-indigo-700 mb-0.5">'+r.period+'</p>'+
                                '<p class="text-xs text-gray-500">Reviewed by <span class="font-medium text-gray-700">'+r.reviewerName+'</span> ('+r.reviewerModel+')</p>'+
                            '</div>'+
                            '<div class="text-right">'+
                                '<p class="text-amber-400 text-xl font-bold">'+stars+'</p>'+
                                '<p class="text-xs font-semibold '+ratingColors[r.rating]+' mt-0.5">'+ratingLabels2[r.rating]+'</p>'+
                            '</div>'+
                        '</div>'+
                        '<p class="text-sm text-gray-700 leading-relaxed mb-4">'+r.comments+'</p>'+
                        (r.strengths ? '<div class="bg-green-50 border border-green-100 rounded-lg p-3 mb-3"><p class="text-xs font-semibold text-green-800 mb-1">Strengths</p><p class="text-xs text-green-700">'+r.strengths+'</p></div>' : '')+
                        (r.improvements ? '<div class="bg-amber-50 border border-amber-100 rounded-lg p-3 mb-3"><p class="text-xs font-semibold text-amber-800 mb-1">Areas for Growth</p><p class="text-xs text-amber-700">'+r.improvements+'</p></div>' : '')+
                        (goals ? '<div class="bg-gray-50 border border-gray-100 rounded-lg p-3"><p class="text-xs font-semibold text-gray-700 mb-2">Goals</p><div class="space-y-1">'+goals+'</div></div>' : '')+
                        '<p class="text-xs text-gray-300 mt-3">'+new Date(r.createdAt).toLocaleDateString('en-IN')+'</p>'+
                    '</div>';
                }).join('');
            } catch(err) {
                listEl.innerHTML = '<p class="text-sm text-red-400">Failed to load reviews.</p>';
            }
        }

        // Hook into showSection so reviews load when tab is clicked
        // Extra showSection hook — runs after the main showSection defined earlier
        // Adds section-specific load calls without redefining showSection
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('button[onclick]');
            if (!btn) return;
            const onclick = btn.getAttribute('onclick') || '';
            if (onclick.includes("'performanceSection'") || onclick.includes('"performanceSection"')) {
                loadMyPerformanceReviews();
            }
        });

</script>

    <!-- ══ ANNOUNCEMENT SYSTEM JS ══════════════════════════════════════════ -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
    (function() {
        /* ── Socket connection ─────────────────────────────────────────── */
        const _socket = typeof io !== 'undefined' ? io() : null;
        let _annPanelOpen = false;

        /* ── On socket connect: request unread count immediately ──────── */
        if (_socket) {
            _socket.on('connect', function() {
                _socket.emit('notifications:get_count');
            });

            /* Real-time: new announcement arrived ─────────────────────── */
            _socket.on('announcement:new', function(ann) {
                // Increment badge
                const badge = document.getElementById('ann-badge');
                if (badge) {
                    const cur = parseInt(badge.textContent) || 0;
                    _setBadge(cur + 1);
                }
                // Prepend to list if panel is open
                if (_annPanelOpen) {
                    _prependAnnouncement(ann);
                } else {
                    // Reload list next time panel opens
                    _annListDirty = true;
                }
                // Flash button
                const btn = document.getElementById('ann-toggle-btn');
                if (btn) {
                    btn.classList.add('bg-blue-100');
                    setTimeout(function() { btn.classList.remove('bg-blue-100'); }, 1500);
                }
            });
        }

        let _annListDirty = true; // force first load

        /* ── Toggle panel open/close ───────────────────────────────────── */
        window.toggleAnnouncementPanel = function() {
            _annPanelOpen = !_annPanelOpen;
            const panel   = document.getElementById('ann-panel');
            const chevron = document.getElementById('ann-chevron');
            if (!panel) return;

            if (_annPanelOpen) {
                panel.classList.remove('hidden');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                if (_annListDirty) _loadAnnouncementList();
                // Mark seen after 1 second (gives user time to read)
                setTimeout(markAllAnnouncementsSeen, 1000);
            } else {
                panel.classList.add('hidden');
                if (chevron) chevron.style.transform = '';
            }
        };

        /* ── Load announcements from API ───────────────────────────────── */
        async function _loadAnnouncementList() {
            const list = document.getElementById('ann-list');
            if (!list) return;
            list.innerHTML = '<p class="text-xs text-gray-400 px-4 py-3">Loading…</p>';
            try {
                const res  = await fetch('/api/overview/announcements');
                const data = await res.json();
                if (!data.success || !data.announcements || data.announcements.length === 0) {
                    list.innerHTML = '<p class="text-xs text-gray-500 px-4 py-3 text-center">No announcements yet.</p>';
                    return;
                }
                list.innerHTML = data.announcements.map(function(a) {
                    return _annCard(a);
                }).join('');
                _annListDirty = false;
            } catch(e) {
                list.innerHTML = '<p class="text-xs text-red-400 px-4 py-3">Failed to load.</p>';
            }
        }

        /* ── Prepend a single new announcement card ────────────────────── */
        function _prependAnnouncement(ann) {
            const list = document.getElementById('ann-list');
            if (!list) return;
            // Remove "no announcements" placeholder if present
            const placeholder = list.querySelector('p');
            if (placeholder) placeholder.remove();
            const div = document.createElement('div');
            div.innerHTML = _annCard(ann);
            list.insertBefore(div.firstChild, list.firstChild);
        }

        /* ── Build HTML card for one announcement — clickable ─────────── */
        function _annCard(a) {
            const dateStr = a.date ? new Date(a.date).toLocaleDateString('en-IN', {
                day: 'numeric', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            }) : '';
            const titleEsc   = _esc(a.title);
            const msgEsc     = _esc(a.message);
            const attachHtml = a.attachmentUrl
                ? '<a href="' + a.attachmentUrl + '" target="_blank" class="mt-2 inline-flex items-center gap-1 text-primary-600 hover:underline text-xs" data-rs-click="employee-dashboard-35"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>View Attachment</a>'
                : '';
            const dataAttach = a.attachmentUrl ? ' data-attach="' + _esc(a.attachmentUrl) + '"' : '';
            return '<div class="px-4 py-3 hover:bg-blue-100 transition-colors cursor-pointer" ' +
                       'data-rs-click="employee-dashboard-36" ' +
                       'data-title="' + titleEsc + '" ' +
                       'data-msg="' + msgEsc + '" ' +
                       'data-date="' + dateStr + '"' + dataAttach + '>' +
                       '<p class="text-xs font-bold text-gray-800 leading-snug">' + titleEsc + '</p>' +
                       '<p class="text-xs text-gray-500 mt-0.5 leading-snug line-clamp-2">' + msgEsc + '</p>' +
                       attachHtml +
                       '<p class="text-xs text-gray-400 mt-1">' + dateStr + '</p>' +
                   '</div>';
        }

        window.openAnnModal = function(el) {
            const title  = el.getAttribute('data-title')  || '';
            const msg    = el.getAttribute('data-msg')    || '';
            const date   = el.getAttribute('data-date')   || '';
            const attach = el.getAttribute('data-attach') || '';
            document.getElementById('ann-modal-title').textContent = title;
            document.getElementById('ann-modal-msg').textContent   = msg;
            document.getElementById('ann-modal-date').textContent  = date;
            const attachEl = document.getElementById('ann-modal-attach');
            if (attach) { attachEl.href = attach; attachEl.classList.remove('hidden'); }
            else { attachEl.classList.add('hidden'); }
            document.getElementById('ann-modal').classList.remove('hidden');
        };

        window.closeAnnModal = function() {
            document.getElementById('ann-modal').classList.add('hidden');
        };

        /* ── Mark all announcements as seen (resets badge) ─────────────── */
        window.markAllAnnouncementsSeen = async function() {
            try {
                await fetch('/api/overview/announcements/mark-seen', { method: 'POST' });
                _setBadge(0);
            } catch(e) {}
        };

        /* ── Set badge count ───────────────────────────────────────────── */
        function _setBadge(n) {
            const badge = document.getElementById('ann-badge');
            if (!badge) return;
            if (n > 0) {
                badge.textContent = n > 99 ? '99+' : n;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
                badge.textContent = '0';
            }
        }

        /* ── HTML-escape helper ────────────────────────────────────────── */
        function _esc(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        /* ── Poll unread count on page load (fallback if socket fails) ─── */
        async function _pollUnreadCount() {
            try {
                const res  = await fetch('/api/overview/announcements/unread-count');
                const data = await res.json();
                if (data.success) _setBadge(data.count);
            } catch(e) {}
        }

        /* ── Init ──────────────────────────────────────────────────────── */
        document.addEventListener('DOMContentLoaded', function() {
            _pollUnreadCount();
        });

    })();
    </script>
    <!-- ══ END ANNOUNCEMENT SYSTEM JS ══════════════════════════════════════ -->

