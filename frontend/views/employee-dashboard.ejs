                  <p class="text-xs text-gray-400 mt-1">days left</p>
                  <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div id="bar-Casual" class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width:0%"></div>
                  </div>
                  <p class="text-xs text-gray-400 mt-1"><span id="used-Casual">0</span> used / <span id="total-Casual">7</span></p>
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 text-center">
                  <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Unpaid</p>
                  <p class="text-2xl font-bold text-gray-500" id="bal-Unpaid">&#8734;</p>
