                                </tr>
                            </thead>
                            <tbody id="assignedTasksBody" class="bg-white divide-y divide-gray-200">
                                <!-- Tasks loaded via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Work Reports Section -->
            <div id="workReportsSection" class="section-content hidden">
