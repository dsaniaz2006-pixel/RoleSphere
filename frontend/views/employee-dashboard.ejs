                        <h4 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-1">Manager Feedback</h4>
                        <div class="bg-red-50 p-3 rounded-lg text-red-700 border border-red-100" id="modalTaskFeedback"></div>
                    </div>
                </div>

                <div class="mt-6 flex justify-end">
                    <button data-rs-click="employee-dashboard-30" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition-colors">Close</button>
