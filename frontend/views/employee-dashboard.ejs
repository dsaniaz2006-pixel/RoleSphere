                        <div>
                            <h4 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-1">Status</h4>
                            <span id="modalTaskStatus" class="inline-flex px-2 py-1 rounded-full text-xs font-bold">-</span>
                        </div>
                    </div>

