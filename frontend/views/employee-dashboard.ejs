                            <p class="text-sm text-gray-500 mb-1">Today — <span id="attTodayDate" class="font-medium text-gray-700"></span></p>
                            <span id="attTodayStatus" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-gray-100 text-gray-600">Not Checked In</span>
                        </div>
                        <div class="flex items-center gap-6 text-sm text-gray-600">
                            <div><p class="text-xs text-gray-400 mb-0.5">Check In</p><p id="attCheckInTime" class="font-mono font-bold text-green-600 text-base">--:--:--</p></div>
                            <div><p class="text-xs text-gray-400 mb-0.5">Check Out</p><p id="attCheckOutTime" class="font-mono font-bold text-red-500 text-base">--:--:--</p></div>
                            <div><p class="text-xs text-gray-400 mb-0.5">Duration</p><p id="attDuration" class="font-mono font-bold text-blue-600 text-base">--:--:--</p></div>
                        </div>
                        <div class="flex gap-3">
                            <button id="checkInBtn" data-rs-click="employee-dashboard-25" class="px-5 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition shadow-sm">Check In</button>
                            <button id="checkOutBtn" data-rs-click="employee-dashboard-26" class="px-5 py-2 bg-red-500 text-white text-sm font-semibold rounded-lg hover:bg-red-600 transition shadow-sm hidden">Check Out</button>
                        </div>
                    </div>
