              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" id="leaveBalanceCards">
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 text-center">
                  <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Annual</p>
                  <p class="text-2xl font-bold text-indigo-600" id="bal-Annual">–</p>
                  <p class="text-xs text-gray-400 mt-1">days left</p>
                  <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div id="bar-Annual" class="h-full bg-indigo-500 rounded-full transition-all duration-500" style="width:0%"></div>
                  </div>
                  <p class="text-xs text-gray-400 mt-1"><span id="used-Annual">0</span> used / <span id="total-Annual">15</span></p>
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 text-center">
                  <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Sick</p>
                  <p class="text-2xl font-bold text-blue-600" id="bal-Sick">–</p>
                  <p class="text-xs text-gray-400 mt-1">days left</p>
                  <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div id="bar-Sick" class="h-full bg-blue-500 rounded-full transition-all duration-500" style="width:0%"></div>
                  </div>
                  <p class="text-xs text-gray-400 mt-1"><span id="used-Sick">0</span> used / <span id="total-Sick">10</span></p>
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 text-center">
                  <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Casual</p>
