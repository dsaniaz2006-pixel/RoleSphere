        // ── Leave Functions (upgraded) ──────────────────────────────────────
        function countWorkingDays(startStr, endStr) {
            const start = new Date(startStr), end = new Date(endStr);
            let count = 0;
            const cur = new Date(start);
            while (cur <= end) {
                const d = cur.getDay();
                if (d !== 0 && d !== 6) count++;
                cur.setDate(cur.getDate() + 1);
            }
            return count || 1;
        }

        function updateDaysPreview() {
            const start   = document.getElementById('leaveStartDate').value;
            const end     = document.getElementById('leaveEndDate').value;
            const type    = document.getElementById('leaveType').value;
            const preview = document.getElementById('daysPreview');
            if (start && end && new Date(end) >= new Date(start)) {
                const days = countWorkingDays(start, end);
                preview.textContent = days + ' working day' + (days > 1 ? 's' : '') + (type ? ' (' + type + ')' : '');
                preview.classList.remove('hidden');
            } else {
                preview.classList.add('hidden');
            }
        }

        async function loadLeaveBalance() {
            try {
                const res  = await fetch('/api/leave/my-balance');
                const data = await res.json();
                if (!data.success) return;
                ['Annual','Sick','Casual','Unpaid'].forEach(function(type) {
                    const b       = data.balance[type];
                    const balEl   = document.getElementById('bal-' + type);
                    const usedEl  = document.getElementById('used-' + type);
                    const totalEl = document.getElementById('total-' + type);
                    const barEl   = document.getElementById('bar-' + type);
                    if (balEl)  balEl.textContent  = type === 'Unpaid' ? '∞' : b.available;
                    if (usedEl) usedEl.textContent = b.used;
                    if (totalEl && type !== 'Unpaid') totalEl.textContent = b.entitled;
                    if (barEl && type !== 'Unpaid' && b.entitled > 0) {
                        barEl.style.width = Math.round(((b.entitled - b.available) / b.entitled) * 100) + '%';
                    }
                });
            } catch (err) { console.error('Balance load error:', err); }
        }

