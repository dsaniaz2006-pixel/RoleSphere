<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/premium-head') %>
<script src="/vendor/purify.min.js"></script><script src="/js/ui.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Manager | RoleSphere</title>

    <!-- Tailwind -->
    <link rel="stylesheet" href="/css/app.css">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">


<%- include('partials/premium-assets') %>
</head>

<body class="bg-gray-50 h-screen flex overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col hidden md:flex">
        <div class="rs-sidebar-brand"><%- include('partials/brand') %></div>

        <nav class="flex-1 overflow-y-auto py-4">
            <div class="px-4 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Overview</div>

            <a href="/api/admin/dashboard"
               class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                Dashboard
            </a>

            <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Management</div>

            <a href="/api/admin/add-hr"
               class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                Add HR
            </a>

            <a href="/api/admin/add-manager"
               class="flex items-center gap-3 px-6 py-3 text-primary-600 bg-primary-50 border-r-4 border-primary-600 transition-all">
                Add Manager
            </a>

            <a href="/api/admin/announcements"
               class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                Announcements
            </a>

            <a href="/api/admin/logout"
               class="flex items-center gap-3 px-6 py-3 text-red-600 hover:bg-red-50 transition-all">
                Logout
            </a>
        </nav>
    </aside>

    <!-- Main -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">

        <!-- Header -->
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6 z-30">
            <h2 class="text-xl font-bold text-gray-800">Add New Manager</h2>

            <!-- STATIC ADMIN INFO (SAFE) -->
            <div class="flex items-center gap-4">
                <div class="text-right hidden sm:block">
                    <div class="text-sm font-bold text-gray-800">Admin</div>
                    <div class="text-xs text-gray-500">Administrator</div>
                </div>
                <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-600 font-bold border-2 border-white shadow-sm">
                    A
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="flex-1 overflow-y-auto p-6">
            <div class="max-w-2xl mx-auto">

                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
                    <div class="mb-6">
                        <h3 class="text-2xl font-bold text-gray-900 mb-2">Add Manager Personnel</h3>
                        <p class="text-gray-600">Create a new manager account for the employee tracking system.</p>
                    </div>

                    <!-- Error -->
                    <% if (error) { %>
                        <div class="mb-6 p-4 bg-red-50 text-red-800 rounded-lg border border-red-200">
                            <%= error %>
                        </div>
                    <% } %>

                    <!-- Form -->
                    <form action="/api/admin/add-manager" method="POST" class="space-y-6">

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                            <input type="text" name="name" required
                                   class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                            <input type="email" name="email" required
                                   class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                            <input type="password" name="password" required
                                   class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" minlength="8" maxlength="128">
                        </div>

                        <div class="flex justify-end gap-4 pt-4">
                            <a href="/api/admin/dashboard"
                               class="px-6 py-3 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition font-medium">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold transition shadow-sm">
                                Add Manager
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </main>
<%- include('partials/site-tools') %>
</body>
</html>
