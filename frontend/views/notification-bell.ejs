<script src="/js/legacy/notification-bell-events.js"></script>
<!-- Notification Bell -->
<div class="relative inline-block" id="notif-wrapper">
  <!-- Bell button -->
  <button
    id="notif-bell"
    data-rs-click="notification-bell-0"
    class="relative p-2 text-gray-500 hover:text-indigo-600 hover:bg-gray-100 rounded-lg transition-colors focus:outline-none"
    aria-label="Notifications"
  >
    <!-- Bell icon -->
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0
           10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6
           0v1a3 3 0 11-6 0v-1m6 0H9"/>
    </svg>
    <!-- Unread count badge -->
    <span
      id="notif-badge"
      class="hidden absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs font-bold
             rounded-full flex items-center justify-center leading-none"
    >0</span>
  </button>

  <!-- Dropdown panel -->
  <div
    id="notif-panel"
    class="hidden absolute right-0 mt-2 w-96 bg-white rounded-2xl shadow-xl border border-gray-100 z-50 overflow-hidden"
    style="max-height: 480px;"
  >
    <!-- Panel header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 bg-gray-50">
      <h3 class="text-sm font-semibold text-gray-900">Notifications</h3>
      <button
        data-rs-click="notification-bell-1"
        class="text-xs text-indigo-600 hover:underline font-medium"
      >Mark all read</button>
    </div>

    <!-- Notification list -->
    <div id="notif-list" class="overflow-y-auto" style="max-height: 380px;">
      <!-- Skeleton shown while loading -->
      <div id="notif-skeleton" class="p-4 space-y-3">
        <div class="h-14 bg-gray-100 rounded-lg animate-pulse"></div>
        <div class="h-14 bg-gray-100 rounded-lg animate-pulse"></div>
        <div class="h-14 bg-gray-100 rounded-lg animate-pulse"></div>
      </div>
    </div>

    <!-- Panel footer -->
    <div class="border-t border-gray-100 px-4 py-2 text-center bg-gray-50">
      <a href="#" data-rs-click="notification-bell-2" class="text-xs text-indigo-600 hover:underline font-medium">
        View all notifications
      </a>
    </div>
  </div>
</div>

<!-- ── Socket.io client + notification logic ─────────────────────────────── -->
<!-- Include Socket.io client script. Add this line ONCE per page, before </body> -->
<!-- <script src="/socket.io/socket.io.js"></script>  ← already in layout -->

<script>
(function () {
  // ── State ──────────────────────────────────────────────────────────────────
  let notifPage   = 1;
  let panelOpen   = false;
  let socketReady = false;

  // ── Socket.io connection ───────────────────────────────────────────────────
  function initSocket() {
    if (typeof io === "undefined") return; // socket.io.js not loaded
    if (socketReady) return;

    const socket = io({ transports: ["websocket", "polling"] });

    socket.on("connect", () => {
      socketReady = true;
      // Ask server for current unread count
      socket.emit("notifications:get_count");
    });

    // Real-time: new notification arrives
    socket.on("notification:new", (notif) => {
      updateBadge(null, true); // bump badge by 1
      // Show a toast
      showToast(notif.title, notif.message, notif.link);
      // If panel is open, prepend the new notification
      if (panelOpen) prependNotification(notif);
    });

    // Real-time: unread count updated
    socket.on("notification:unread_count", ({ count }) => {
      updateBadge(count);
    });

    window._rs_socket = socket; // expose globally so other scripts can emit
  }

  // ── Badge ──────────────────────────────────────────────────────────────────
  function updateBadge(count, bump) {
    const badge = document.getElementById("notif-badge");
    if (!badge) return;
    let current = parseInt(badge.textContent) || 0;
    const newCount = bump ? current + 1 : (count ?? current);
    if (newCount > 0) {
      badge.textContent = newCount > 99 ? "99+" : newCount;
      badge.classList.remove("hidden");
    } else {
      badge.classList.add("hidden");
    }
  }

  // ── Panel toggle ───────────────────────────────────────────────────────────
  window.toggleNotifPanel = function () {
    const panel = document.getElementById("notif-panel");
    panelOpen = !panelOpen;
    panel.classList.toggle("hidden", !panelOpen);
    if (panelOpen) loadNotifications();
  };

  // Close panel when clicking outside
  document.addEventListener("click", (e) => {
    const wrapper = document.getElementById("notif-wrapper");
    if (wrapper && !wrapper.contains(e.target) && panelOpen) {
      document.getElementById("notif-panel").classList.add("hidden");
      panelOpen = false;
    }
  });

  // ── Load notifications via REST ────────────────────────────────────────────
  async function loadNotifications() {
    const list     = document.getElementById("notif-list");
    const skeleton = document.getElementById("notif-skeleton");
    if (skeleton) skeleton.classList.remove("hidden");

    try {
      const res  = await fetch(`/api/notifications?page=1&limit=15`);
      const data = await res.json();
      if (skeleton) skeleton.classList.add("hidden");

      if (!data.success || !data.notifications.length) {
        list.innerHTML = `
          <div class="p-8 text-center">
            <p class="text-2xl mb-2">🔔</p>
            <p class="text-sm text-gray-500 font-medium">You're all caught up!</p>
          </div>`;
        return;
      }

      list.innerHTML = data.notifications.map(renderNotification).join("");
    } catch (err) {
      if (skeleton) skeleton.classList.add("hidden");
      list.innerHTML = `<p class="p-4 text-sm text-red-500">Failed to load notifications.</p>`;
    }
  }

  window.loadAllNotifications = function () {
    loadNotifications();
  };

  // ── Render one notification row ────────────────────────────────────────────
  function renderNotification(n) {
    const icon  = typeIcon(n.type);
    const time  = timeAgo(new Date(n.createdAt));
    const unread = !n.isRead ? "bg-indigo-50 border-l-4 border-indigo-400" : "";
    const link  = n.link ? `href="${n.link}"` : `href="#" data-rs-click="notification-bell-3"`;

    return `
      <a ${link}
         data-rs-click="notification-bell-4" data-rs-arg-0="${escapeHtml(n._id)}"
         class="flex gap-3 px-4 py-3 hover:bg-gray-50 transition-colors cursor-pointer no-underline ${unread}"
      >
        <div class="w-9 h-9 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0 text-lg">
          ${icon}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-900 truncate">${escHtml(n.title)}</p>
          <p class="text-xs text-gray-600 mt-0.5 line-clamp-2">${escHtml(n.message)}</p>
          <p class="text-xs text-gray-400 mt-1">${time}</p>
        </div>
        ${!n.isRead ? '<div class="w-2 h-2 bg-indigo-500 rounded-full mt-2 flex-shrink-0"></div>' : ''}
      </a>`;
  }

  // ── Prepend a new live notification to the list ────────────────────────────
  function prependNotification(n) {
    const list = document.getElementById("notif-list");
    // Remove "all caught up" if present
    const empty = list.querySelector(".text-center");
    if (empty) empty.remove();
    list.insertAdjacentHTML("afterbegin", renderNotification(n));
  }

  // ── Mark single notification as read ──────────────────────────────────────
  window.markRead = async function (id, el) {
    try {
      await fetch(`/api/notifications/${id}/read`, { method: "PATCH" });
      // Remove unread styles
      if (el) {
        el.classList.remove("bg-indigo-50", "border-l-4", "border-indigo-400");
        const dot = el.querySelector(".bg-indigo-500.rounded-full");
        if (dot) dot.remove();
      }
      // Update badge
      const res  = await fetch("/api/notifications/unread-count");
      const data = await res.json();
      if (data.success) updateBadge(data.count);
    } catch (err) {
      console.error("markRead error:", err);
    }
  };

  // ── Mark all as read ───────────────────────────────────────────────────────
  window.markAllRead = async function () {
    try {
      await fetch("/api/notifications/read-all", { method: "PATCH" });
      updateBadge(0);
      // Remove all unread styles from visible items
      document.querySelectorAll("#notif-list a").forEach(el => {
        el.classList.remove("bg-indigo-50", "border-l-4", "border-indigo-400");
        const dot = el.querySelector(".bg-indigo-500.rounded-full");
        if (dot) dot.remove();
      });
    } catch (err) {
      console.error("markAllRead error:", err);
    }
  };

  // ── Toast notification ─────────────────────────────────────────────────────
  function showToast(title, message, link) {
    let container = document.getElementById("rs-toast-container");
    if (!container) {
      container = document.createElement("div");
      container.id = "rs-toast-container";
      container.style.cssText = "position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;";
      document.body.appendChild(container);
    }

    const toast = document.createElement("div");
    toast.style.cssText = `
      background:white;border-radius:12px;padding:16px;width:320px;
      box-shadow:0 10px 25px rgba(0,0,0,0.15);border-left:4px solid #4f46e5;
      display:flex;align-items:flex-start;gap:12px;animation:slideUp 0.3s ease;
    `;
    toast.innerHTML = `
      <div style="font-size:20px;">🔔</div>
      <div style="flex:1;min-width:0;">
        <p style="margin:0;font-size:14px;font-weight:600;color:#111827;">${escHtml(title)}</p>
        <p style="margin:4px 0 0;font-size:12px;color:#6b7280;line-clamp:2;">${escHtml(message)}</p>
      </div>
      <button data-rs-click="notification-bell-5" style="background:none;border:none;cursor:pointer;color:#9ca3af;font-size:16px;padding:0;">×</button>
    `;

    if (link) toast.style.cursor = "pointer";
    if (link) toast.addEventListener("click", () => { window.location.href = link; });

    container.appendChild(toast);
    setTimeout(() => { if (toast.parentElement) toast.remove(); }, 5000);
  }

  // ── Helpers ────────────────────────────────────────────────────────────────
  function typeIcon(type) {
    const icons = {
      leave:        "🏖️",
      task:         "📋",
      attendance:   "📅",
      transfer:     "🔄",
      complaint:    "📣",
      announcement: "📢",
      system:       "⚙️"
    };
    return icons[type] || "🔔";
  }

  function timeAgo(date) {
    const seconds = Math.floor((Date.now() - date) / 1000);
    if (seconds < 60)   return "just now";
    if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
    if (seconds < 86400)return `${Math.floor(seconds / 3600)}h ago`;
    return `${Math.floor(seconds / 86400)}d ago`;
  }

  function escHtml(str) {
    if (!str) return "";
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  // Add slideUp animation
  const style = document.createElement("style");
  style.textContent = `@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}`;
  document.head.appendChild(style);

  // ── Init ───────────────────────────────────────────────────────────────────
  // Load unread count on page load
  (async function () {
    try {
      const res  = await fetch("/api/notifications/unread-count");
      const data = await res.json();
      if (data.success) updateBadge(data.count);
    } catch {}

    // Init socket after a brief delay (let page finish loading)
    setTimeout(initSocket, 500);
  })();
})();
</script>
