<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/premium-head') %>
<script src="/vendor/purify.min.js"></script><script src="/js/ui.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Attendance | RoleSphere</title>
    <link rel="stylesheet" href="/css/app.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
<script src="/js/legacy/hr-attendance-report-events.js"></script>
<%- include('partials/premium-assets') %>
</head>
<body class="bg-gray-50 h-screen flex overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col hidden md:flex">
        <div class="rs-sidebar-brand"><%- include('partials/brand') %></div>
        <nav class="flex-1 overflow-y-auto py-4">
            <a href="/api/admin/dashboard" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">Dashboard</a>
            <a href="/api/admin/add-hr" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">Add HR</a>
            <a href="/api/admin/add-manager" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">Add Manager</a>
            <a href="/api/admin/pending-approvals" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">Pending Approvals</a>
            <a href="/admin/hr-attendance" class="flex items-center gap-3 px-6 py-3 bg-blue-50 text-blue-600 font-medium border-r-2 border-blue-600">HR Attendance</a>
            <a href="/api/admin/announcements" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">Announcements</a>
            <a href="/api/admin/logout" class="flex items-center gap-3 px-6 py-3 text-red-600 hover:bg-red-50 transition-all">Logout</a>
        </nav>
    </aside>

    <!-- Main -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6">
            <h2 class="text-xl font-bold text-gray-800">HR Attendance</h2>
            <div class="text-sm font-bold text-gray-700"><%= admin && admin.name ? admin.name : "Admin" %></div>
        </header>

        <div class="flex-1 overflow-y-auto p-6 space-y-6">

            <!-- Filters -->
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 flex flex-wrap gap-6 items-end">
                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase block mb-1">View by Date</label>
                    <div class="flex gap-2">
                        <input type="date" id="hrDatePicker" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <button data-rs-click="hr-attendance-report-0" class="px-4 py-1.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition">View</button>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase block mb-1">View by Month</label>
                    <div class="flex gap-2">
                        <input type="month" id="hrMonthPicker" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <button data-rs-click="hr-attendance-report-1" class="px-4 py-1.5 bg-gray-600 text-white text-sm font-semibold rounded-lg hover:bg-gray-700 transition">View</button>
                    </div>
                </div>
            </div>

            <!-- Summary -->
            <div class="grid grid-cols-3 gap-4" id="summaryCards" style="display:none">
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 text-center">
                    <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Present</p>
                    <p id="sumPresent" class="text-3xl font-bold text-green-600">0</p>
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 text-center">
                    <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Absent</p>
                    <p id="sumAbsent" class="text-3xl font-bold text-red-500">0</p>
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 text-center">
                    <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Total HRs</p>
                    <p id="sumTotal" class="text-3xl font-bold text-gray-800">0</p>
                </div>
            </div>

            <!-- Table -->
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <table class="min-w-full divide-y divide-gray-100">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Day</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Check In</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Check Out</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Duration</th>
                        </tr>
                    </thead>
                    <tbody id="hrAttBody" class="divide-y divide-gray-50">
                        <tr><td colspan="7" class="px-6 py-12 text-center text-gray-400">Select a date or month above to view HR attendance</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
    const DAYS_N = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

    function fmtDur(ci, co) {
        if (!ci||ci==='-'||!co||co==='-') return '--:--:--';
        const ts = t => { const [h,m,s]=t.split(':').map(Number); return h*3600+m*60+s; };
        let d=ts(co)-ts(ci); if(d<0)d+=86400;
        return [Math.floor(d/3600),Math.floor((d%3600)/60),d%60].map(n=>String(n).padStart(2,'0')).join(':');
    }

    async function loadHRByDate() {
        const date = document.getElementById('hrDatePicker').value;
        if (!date) return alert('Pick a date');
        try {
            const r = await fetch(`/api/attendance/hrs?date=${date}`);
            const d = await r.json();
            const hrs = d.hrs || [];
            let present=0, absent=0;
            let html = hrs.map(hr => {
                const dow = new Date(date).getDay();
                const dayName = DAYS_N[dow];
                const isSun = dow === 0;
                let badge, rowCls = '';
                if (isSun) { badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">Holiday</span>'; rowCls='bg-purple-50'; }
                else if (hr.status==='present') { badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Present</span>'; present++; }
                else { badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">Absent</span>'; rowCls='bg-red-50'; absent++; }
                return `<tr class="${rowCls} hover:bg-gray-50">
                    <td class="px-6 py-3 text-sm font-medium text-gray-900">${escapeHtml(hr.name)}</td>
                    <td class="px-6 py-3 text-sm text-gray-600">${date}</td>
                    <td class="px-6 py-3 text-sm text-gray-600">${dayName}</td>
                    <td class="px-6 py-3">${badge}</td>
                    <td class="px-6 py-3 text-sm font-mono ${hr.checkIn&&hr.checkIn!=='-'?'text-green-600 font-semibold':'text-gray-400'}">${hr.checkIn||'-'}</td>
                    <td class="px-6 py-3 text-sm font-mono ${hr.checkOut&&hr.checkOut!=='-'?'text-red-500 font-semibold':'text-gray-400'}">${hr.checkOut||'-'}</td>
                    <td class="px-6 py-3 text-sm font-mono text-blue-600">${fmtDur(hr.checkIn,hr.checkOut)}</td>
                </tr>`;
            }).join('');
            document.getElementById('hrAttBody').innerHTML = html || '<tr><td colspan="7" class="px-6 py-8 text-center text-gray-400">No HR records found</td></tr>';
            document.getElementById('sumPresent').innerText = present;
            document.getElementById('sumAbsent').innerText = absent;
            document.getElementById('sumTotal').innerText = hrs.length;
            document.getElementById('summaryCards').style.display = 'grid';
        } catch(e) { console.error(e); alert('Failed to load attendance'); }
    }

    async function loadHRByMonth() {
        const m = document.getElementById('hrMonthPicker').value;
        if (!m) return alert('Pick a month');
        try {
            const r = await fetch(`/api/attendance/hrs?month=${m}`);
            const d = await r.json();
            const hrs = d.hrs || [];
            const records = d.records || [];
            const [y,mo] = m.split('-').map(Number);
            const dim = new Date(y,mo,0).getDate();
            let html='', present=0, absent=0;
            for (const hr of hrs) {
                for (let day=1;day<=dim;day++) {
                    const ds=`${y}-${String(mo).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
                    const dow=new Date(ds).getDay();
                    const isSun=dow===0;
                    const rec=records.find(r=>r.userId?.toString()===hr._id?.toString()&&r.date===ds);
                    let badge,rowCls='';
                    if(isSun){badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">Holiday</span>';rowCls='bg-purple-50';}
                    else if(rec?.checkIn){badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">Present</span>';present++;}
                    else{badge='<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">Absent</span>';rowCls='bg-red-50';if(!isSun)absent++;}
                    html+=`<tr class="${rowCls} hover:bg-gray-50">
                        <td class="px-6 py-3 text-sm font-medium text-gray-900">${escapeHtml(hr.name)}</td>
                        <td class="px-6 py-3 text-sm text-gray-600">${ds}</td>
                        <td class="px-6 py-3 text-sm text-gray-600">${escapeHtml(DAYS_N[dow])}</td>
                        <td class="px-6 py-3">${badge}</td>
                        <td class="px-6 py-3 text-sm font-mono ${rec?.checkIn?'text-green-600 font-semibold':'text-gray-400'}">${rec?.checkIn||'-'}</td>
                        <td class="px-6 py-3 text-sm font-mono ${rec?.checkOut?'text-red-500 font-semibold':'text-gray-400'}">${rec?.checkOut||'-'}</td>
                        <td class="px-6 py-3 text-sm font-mono text-blue-600">${fmtDur(rec?.checkIn,rec?.checkOut)}</td>
                    </tr>`;
                }
            }
            document.getElementById('hrAttBody').innerHTML = html||'<tr><td colspan="7" class="px-6 py-8 text-center text-gray-400">No records</td></tr>';
            document.getElementById('sumPresent').innerText = present;
            document.getElementById('sumAbsent').innerText = absent;
            document.getElementById('sumTotal').innerText = hrs.length;
            document.getElementById('summaryCards').style.display = 'grid';
        } catch(e) { console.error(e); alert('Failed to load attendance'); }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const now = new Date();
        document.getElementById('hrDatePicker').value = now.toISOString().split('T')[0];
        document.getElementById('hrMonthPicker').value = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
    });
    </script>
<%- include('partials/site-tools') %>
</body>
</html>