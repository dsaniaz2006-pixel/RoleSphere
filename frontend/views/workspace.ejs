<!DOCTYPE html><html lang="en"><head>
<%- include('partials/premium-head') %><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Workspace | RoleSphere</title>
<link rel="stylesheet" href="/css/app.css"><script src="/vendor/purify.min.js"></script><script src="/js/ui.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" defer></script><script src="/vendor/sortable.min.js" defer></script><script src="/js/workspace.js" defer></script>
<style>body{font-family:system-ui,sans-serif;background:#f8fafc;color:#111827;padding:1.5rem}.workspace{max-width:1200px;margin:auto}button,input,select{padding:.5rem .75rem;border:1px solid #94a3b8;border-radius:.3rem}button:disabled{opacity:.5}nav{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}section{margin:1rem 0}table{width:100%;border-collapse:collapse}td,th{text-align:left;border-bottom:1px solid #cbd5e1;padding:.65rem}canvas{max-height:300px}.panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem}.panel{background:white;border:1px solid #cbd5e1;border-radius:.5rem;padding:1rem}.columns{display:flex;overflow:auto;gap:1rem}.column{flex:1;min-width:220px;background:#e2e8f0;border-radius:.5rem;padding:.75rem}.cards{min-height:200px}.task{background:white;padding:.75rem;margin:.5rem 0;border:1px solid #94a3b8;border-radius:.3rem}.task button{margin:.3rem}.org ul{margin:.5rem 0 .5rem 1rem;border-left:1px solid #94a3b8;padding-left:1rem}.muted{color:#64748b}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:600px){body{padding:.5rem}.table-wrap{overflow:auto}}
</style><%- include('partials/premium-assets') %>
</head><body class="rs-hover-scope" data-role="<%= user.role %>"><header class="rs-page-brand"><%- include('partials/brand') %></header><main class="workspace"><header><a id="back-dashboard" href="/dashboard">Back to dashboard</a><h1 class="text-2xl font-bold mt-4">RoleSphere workspace</h1><p><%= user.name %> · <%= user.role %></p><p class="muted">Your people, projects and progress, in one place.</p></header>
<a href="/workbench">Open profile, calendar, progress & teams ↗</a><nav aria-label="Workspace sections">
<% if (['Admin','HR'].includes(user.role)) { %><button data-tab="analytics">Analytics</button><% } %>
<% if (['Admin','HR','Manager'].includes(user.role)) { %><button data-tab="people">People</button><% } %>
<% if (['Manager','Employee'].includes(user.role)) { %><button data-tab="board">Task board</button><% } %>
<% if (user.role === 'Admin') { %><button data-tab="activity">Activity</button><% } %>
</nav><p id="workspace-status" role="status"></p>
<section id="analytics" hidden><h2 class="text-xl font-semibold">Company analytics</h2><div class="panels">
<div class="panel"><h3>Attendance · last 30 days</h3><canvas id="attendance-chart" aria-label="Present and late attendance"></canvas></div>
<div class="panel"><h3>Task status</h3><canvas id="tasks-chart" aria-label="Tasks by status"></canvas></div>
<div class="panel"><h3>Approved leave days by month</h3><canvas id="leaves-chart" aria-label="Leave days by month"></canvas></div>
<div class="panel"><h3>Department headcount</h3><canvas id="departments-chart" aria-label="Employees by department"></canvas></div></div></section>
<section id="people" hidden><h2 class="text-xl font-semibold">People</h2><form id="people-filter" class="my-4"><label>Search <input name="q" type="search" maxlength="80"></label><label>Type <select name="type"><option value="employees">Employees</option><% if (user.role !== 'Manager') { %><option value="managers">Managers</option><option value="hrs">HR</option><% } %></select></label><label>Status <select name="status"><option value="">All</option><option>approved</option><option>pending</option><option>rejected</option></select></label><label>Sort <select name="sort"><option value="name">Name A–Z</option><option value="-name">Name Z–A</option><option value="email">Email</option><option value="department">Department</option></select></label><button>Apply</button></form><div id="people-results" class="table-wrap"></div><div id="people-paging" class="my-4"></div>
<% if (['Admin','HR'].includes(user.role)) { %><h3 class="text-lg font-semibold">Organization</h3><div id="org-chart" class="org"></div><% } %></section>
<section id="board" hidden><h2 class="text-xl font-semibold">Task board</h2><p class="muted">Drag a card or use its move buttons. Manager decisions require a submitted task.</p><div id="task-board" class="columns my-4"></div>
<% if (user.role === 'Employee') { %><h3 class="text-lg font-semibold">Personal to-dos</h3><form id="todo-add"><label>New to-do <input name="text" required maxlength="1000"></label><button>Add</button></form><div id="todo-board" class="columns my-4"></div><% } %></section>
<section id="activity" hidden><h2 class="text-xl font-semibold">Activity log</h2><form id="audit-filter" class="my-4"><label>Action <input name="action" placeholder="e.g. leave.approve" maxlength="100"></label><button>Filter</button></form><div id="audit-results" class="table-wrap"></div><div id="audit-paging" class="my-4"></div></section>
</main><%- include('partials/site-tools') %>
</body></html>
