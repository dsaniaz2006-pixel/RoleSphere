                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="p-6">
            <h2 id="ann-modal-title" class="text-xl font-bold text-gray-900 mb-3"></h2>
            <p id="ann-modal-msg" class="text-gray-600 text-sm leading-relaxed mb-4 whitespace-pre-wrap"></p>
