<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/premium-head') %>
<script src="/vendor/purify.min.js"></script><script src="/js/ui.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pending Approvals | RoleSphere</title>
    <link rel="stylesheet" href="/css/app.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<script src="/js/legacy/pending-approvals-events.js"></script>
<%- include('partials/premium-assets') %>
</head>
<body class="bg-gray-50 h-screen flex overflow-hidden" style="font-family: 'Inter', sans-serif;">

    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col hidden md:flex">
        <div class="rs-sidebar-brand"><%- include('partials/brand') %></div>
        <nav class="flex-1 overflow-y-auto py-4">
            <div class="px-4 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Overview</div>
            <a href="/api/admin/dashboard" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                Dashboard
            </a>
            <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Management</div>
            <a href="/api/admin/pending-approvals" class="flex items-center gap-3 px-6 py-3 bg-primary-50 text-primary-600 font-medium border-r-2 border-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Pending Approvals
            </a>
            <a href="/api/admin/add-hr" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                Add HR
            </a>
            <a href="/api/admin/add-manager" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                Add Manager
            </a>
            <a href="/api/admin/announcements" class="flex items-center gap-3 px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary-600 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Announcements
            </a>
            <a href="/api/admin/logout" class="flex items-center gap-3 px-6 py-3 text-red-600 hover:bg-red-50 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Logout
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6 z-30">
            <h2 class="text-xl font-bold text-gray-800">Pending Approvals</h2>
            <div class="flex items-center gap-4">
                <div class="text-right hidden sm:block">
                    <div class="text-sm font-bold text-gray-800"><%= admin && admin.name ? admin.name : "Admin" %></div>
                    <div class="text-xs text-gray-500">Admin</div>
                </div>
                <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-600 font-bold border-2 border-white shadow-sm">
                    <%= (admin && admin.name ? admin.name.charAt(0) : 'A') %>
                </div>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-6 space-y-8">

            <!-- MODIFIED: Removed pendingEmployees from the count -->
            <%
              const totalPending = pendingManagers.length + pendingHRs.length;
            %>

            <% if (totalPending === 0) { %>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-12 text-center">
                    <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <p class="text-gray-500 text-lg font-medium">All clear! No pending registrations.</p>
                </div>
            <% } %>

            <!-- Managers Pending -->
            <% if (pendingManagers.length > 0) { %>
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-gray-100 flex items-center gap-3">
                    <div class="p-2 bg-purple-50 text-purple-600 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                    </div>
                    <h3 class="font-semibold text-gray-800">Managers <span class="ml-2 text-sm bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full"><%= pendingManagers.length %></span></h3>
                </div>
                <table class="min-w-full divide-y divide-gray-100">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Email</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        <% pendingManagers.forEach(user => { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= user.name %></td>
                            <td class="px-6 py-4 text-sm text-gray-500"><%= user.email %></td>
                            <td class="px-6 py-4 text-right flex justify-end gap-2">
                                <form action="/api/admin/approve-user" method="POST" class="inline">
                                    <input type="hidden" name="userId" value="<%= user._id %>">
                                    <input type="hidden" name="role" value="Manager">
                                    <button type="submit" class="px-4 py-1.5 bg-green-600 text-white text-xs font-semibold rounded-lg hover:bg-green-700 transition">Approve</button>
                                </form>
                                <form action="/api/admin/reject-user" method="POST" class="inline" data-rs-submit="pending-approvals-1">
                                    <input type="hidden" name="userId" value="<%= user._id %>">
                                    <input type="hidden" name="role" value="Manager">
                                    <button type="submit" class="px-4 py-1.5 bg-red-100 text-red-700 text-xs font-semibold rounded-lg hover:bg-red-200 transition">Reject</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>

            <!-- HRs Pending -->
            <% if (pendingHRs.length > 0) { %>
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-gray-100 flex items-center gap-3">
                    <div class="p-2 bg-green-50 text-green-600 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h3 class="font-semibold text-gray-800">HR Staff <span class="ml-2 text-sm bg-green-100 text-green-700 px-2 py-0.5 rounded-full"><%= pendingHRs.length %></span></h3>
                </div>
                <table class="min-w-full divide-y divide-gray-100">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Email</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        <% pendingHRs.forEach(user => { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= user.name %></td>
                            <td class="px-6 py-4 text-sm text-gray-500"><%= user.email %></td>
                            <td class="px-6 py-4 text-right flex justify-end gap-2">
                                <form action="/api/admin/approve-user" method="POST" class="inline">
                                    <input type="hidden" name="userId" value="<%= user._id %>">
                                    <input type="hidden" name="role" value="HR">
                                    <button type="submit" class="px-4 py-1.5 bg-green-600 text-white text-xs font-semibold rounded-lg hover:bg-green-700 transition">Approve</button>
                                </form>
                                <form action="/api/admin/reject-user" method="POST" class="inline" data-rs-submit="pending-approvals-2">
                                    <input type="hidden" name="userId" value="<%= user._id %>">
                                    <input type="hidden" name="role" value="HR">
                                    <button type="submit" class="px-4 py-1.5 bg-red-100 text-red-700 text-xs font-semibold rounded-lg hover:bg-red-200 transition">Reject</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>

        </div>
    </main>

<%- include('partials/site-tools') %>
</body>
</html>