{
  "name": "rolesphere",
  "version": "1.1.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm:build:css -- --watch\" \"npm:build:ui -- --watch\" \"nodemon server.js\"",
    "build:css": "tailwindcss -i frontend/src/tailwind.css -o frontend/public/css/app.css --minify",
    "build:vendor": "node scripts/vendor.js",
    "build": "npm run build:vendor && npm run build:ui && npm run build:css",
    "test": "jest --runInBand",
    "test:integration": "jest tests/integration.test.js --runInBand",
    "seed": "node scripts/seed.js",
    "check": "node scripts/check.js",
    "build:ui": "node scripts/build-ui.js",
    "typecheck": "tsc --noEmit",
    "doctor:google": "node scripts/doctor-google.js",
    "test:unit": "jest --runInBand --testPathIgnorePatterns='integration.test.js|e2e-http.test.js'",
    "test:integration:mocked": "jest tests/google-auth.test.js tests/predeploy-regressions.test.js --runInBand",
    "test:e2e": "jest tests/e2e-http.test.js --runInBand",
    "test:tdd": "jest tests/predeploy-regressions.test.js tests/password-reset-regressions.test.js tests/legacy-registration-regression.test.js tests/realtime-notifications.test.js tests/architecture.test.js tests/build-config.test.js --runInBand",
    "https:setup": "node scripts/https-setup.js",
    "doctor:https": "node scripts/doctor-https.js",
    "dev:https": "node scripts/launch-https.js",
    "test:https": "jest tests/https.test.js --runInBand",
    "test:architecture": "jest tests/architecture.test.js tests/realtime-notifications.test.js tests/build-config.test.js --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "RoleSphere Employee Tracking System",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "clsx": "^2.1.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.2.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "8.7.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "framer-motion": "^14.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.59.0",
    "moment": "^2.30.1",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.15.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.1",
    "sortablejs": "^1.15.2",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^nodemailer$": "<rootDir>/tests/mocks/nodemailer.js"
    },
    "setupFiles": [
      "<rootDir>/tests/setup-email-env.js"
    ]
  }
}
