MONGO_URI=mongodb://127.0.0.1:27017/rolesphere
SESSION_SECRET=
JWT_SECRET=
PORT=8000
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
HTTPS_ENABLED=false
# Local HTTPS: run npm run https:setup. These are generated on your own Mac.
TLS_CERT_PATH=certs/localhost.pem
TLS_KEY_PATH=certs/localhost-key.pem
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
BASE_URL=http://localhost:8000
ENABLE_MONTHLY_REPORTS=false
MONTHLY_REPORT_TO=
# Seed refuses any database except rolesphere_demo.
DEMO_PASSWORD=replace-with-your-own-demo-password

# Google OAuth 2.0 Web application credentials (from Google Cloud Console)
# Register EXACTLY this URI in Google Cloud: http://localhost:8000/api/auth/google/callback
# If your server runs on port 8001, set PORT=8001 and change GOOGLE_REDIRECT_URI to port 8001.
# Run npm run doctor:google to check locally without revealing any secret.
# Local HTTPS example: https://localhost:8001/api/auth/google/callback
# For live deployments, use an HTTPS callback URI from your public domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
